---
/**
 * Token Calculator 页面：/{lang}/calculator/token/
 *
 * 静态壳 + TokenCalculator 岛组件（客户端交互）：
 * - TokenInput：文本输入 + 模型系列选择
 * - TokenResult：Token 数（GPT 精确 / 其余估算）+ 字符数
 * - CostComparison：4 系列成本对比（价格来自 Worker API → D1）
 */
import { LOCALES } from '../../../../i18n/locales';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TokenCalculator from '../../../../components/token/TokenCalculator';
import { getLangFromUrl, useI18n } from '../../../../i18n/ui';

// Astro 7 要求动态段显式声明参数列表
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);

// 提取岛组件所需文案（全部来自 i18n 字典）
const ui = {
  inputLabel: t('token.inputLabel'),
  inputPlaceholder: t('token.inputPlaceholder'),
  familyLabel: t('token.familyLabel'),
  familyGpt: t('token.familyGpt'),
  familyClaude: t('token.familyClaude'),
  familyGemini: t('token.familyGemini'),
  familyDeepSeek: t('token.familyDeepSeek'),
  clear: t('token.clear'),
  tokens: t('token.tokens'),
  characters: t('token.characters'),
  estimationNote: t('token.estimationNote'),
  exactNote: t('token.exactNote'),
  costTitle: t('token.costTitle'),
  costModel: t('token.costModel'),
  costTokens: t('token.costTokens'),
  costInput: t('token.costInput'),
  costOutput: t('token.costOutput'),
  costNote: t('token.costNote'),
  priceUnavailable: t('token.priceUnavailable'),
  costLoading: t('token.costLoading'),
  error: t('token.error'),
  retry: t('token.retry'),
  emptyHint: t('token.emptyHint'),
};
---

<BaseLayout title={t('token.pageTitle')} description={t('site.tagline')}>
  <div class="mx-auto max-w-4xl">
    <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{t('token.pageTitle')}</h1>
    <p class="mt-2 text-sm text-slate-400">{t('site.tagline')}</p>

    <div class="mt-6">
      <TokenCalculator client:load lang={lang} ui={ui} />
    </div>
  </div>
</BaseLayout>
