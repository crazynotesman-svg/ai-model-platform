---
/**
 * 模型比较页：/{lang}/compare/{a}-vs-{b}/
 *
 * SSG：构建期从 D1 导出数据（src/generated/）生成全部模型两两比较页（7 语言 × C(11,2)=55 对）。
 * 对比项：价格（Input/Output）、Context Window、Provider、发布日期、适合场景、
 *         能力矩阵（Phase 9.3）、价格趋势（历史价格，Phase 9.3）。
 * SEO：本地化 title/description、hreflang/canonical（BaseLayout→SEO 组件）、
 *      JSON-LD @graph：两个 SoftwareApplication + BreadcrumbList（Phase 9.3）。
 */
import { LOCALES, type Locale } from '../../../i18n/locales';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DataTrustBadge from '../../../components/data/DataTrustBadge.astro';
import FAQSchema from '../../../components/seo/FAQSchema.astro';
import { getLangFromUrl, useI18n } from '../../../i18n/ui';
import { allComparePairs, capabilityMap, CAPABILITY_ROWS, parseComparePair } from '../../../lib/compare';
import { BENCHMARK_CATEGORIES } from '../../../lib/benchmark';
import { MODEL_SLUGS } from '../../../generated/model-slugs';
import catalogJson from '../../../generated/model-catalog.json';

// ---- 生成数据类型（与 scripts/export-models.mjs 输出一致）----
interface CatalogEntry {
  slug: string;
  modelType: string;
  contextWindow: number | null;
  releaseDate: string | null;
  providerName: string;
  inputPrice: number | null;
  outputPrice: number | null;
  currency: string;
  unit: string;
  translations: Partial<
    Record<string, { name?: string; description?: string | null; useCases?: string[] | null } | undefined>
  >;
  capabilities?: { capability: string; supported: boolean; confidence?: number | null }[];
  pricingHistory?: {
    effectiveDate: string;
    inputPrice: number;
    outputPrice: number;
    confidence?: number | null;
    sourceUrl?: string | null;
  }[];
  benchmarks?: {
    category: string;
    categoryName: string;
    score: number;
    rank: number | null;
    dataset: string;
    version: string;
    testedAt: string | null;
    confidence?: number | null;
    sourceUrl?: string | null;
    verificationStatus?: string;
  }[];
  ranking?: { overall: number; benchmark: number; capability: number; price: number; context: number };
  rankingHistory?: { date: string; rank: number; score: number }[];
  confidenceScore?: number | null;
}
const catalog = catalogJson as Record<string, CatalogEntry>;

// 组合 lang × 全部比较对
export function getStaticPaths() {
  const pairs = allComparePairs(MODEL_SLUGS);
  const paths: { params: { lang: string; pair: string } }[] = [];
  for (const lang of LOCALES) {
    for (const pair of pairs) {
      paths.push({ params: { lang, pair } });
    }
  }
  return paths;
}

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);
const parsed = parseComparePair(Astro.params.pair ?? '');

// 非法 pair 或模型不存在 → 404
const modelA = parsed ? catalog[parsed.a] : undefined;
const modelB = parsed ? catalog[parsed.b] : undefined;
if (!parsed || !modelA || !modelB || parsed.a === parsed.b) {
  return Astro.redirect('/404');
}

// 本地化展示数据
const entryOf = (m: CatalogEntry) => {
  const tr = m.translations[lang] ?? m.translations.en ?? {};
  return {
    slug: m.slug,
    name: tr.name ?? m.slug,
    description: tr.description ?? '',
    useCases: tr.useCases ?? [],
    providerName: m.providerName,
    contextWindow: m.contextWindow,
    releaseDate: m.releaseDate,
    inputPrice: m.inputPrice,
    outputPrice: m.outputPrice,
    currency: m.currency,
    unit: m.unit,
    capabilities: m.capabilities ?? [],
    pricingHistory: m.pricingHistory ?? [],
    benchmarks: m.benchmarks ?? [],
    ranking: m.ranking,
    rankingHistory: m.rankingHistory ?? [],
  };
};
const A = entryOf(modelA);
const B = entryOf(modelB);

// ---- Benchmark Comparison（Phase 9.4b）----
// 规则：仅比较同 dataset + 同 version 的结果；缺失显示 '—'
interface BenchmarkCompareRow {
  category: string;
  labelKey: string;
  a: string;
  b: string;
}
const benchmarkCompareRows: BenchmarkCompareRow[] = BENCHMARK_CATEGORIES.map((cat) => {
  const ba = A.benchmarks.find((b) => b.category === cat.slug);
  const bb = B.benchmarks.find((b) => b.category === cat.slug);
  const comparable = Boolean(ba && bb && ba.dataset === bb.dataset && ba.version === bb.version);
  return {
    category: cat.slug,
    labelKey: cat.labelKey,
    a: ba && comparable ? String(ba.score) : '—',
    b: bb && comparable ? String(bb.score) : '—',
  };
});

const fmtNumber = (n: number | null): string =>
  n == null ? '—' : n.toLocaleString(lang === 'en' ? 'en-US' : lang);
const fmtPrice = (n: number | null): string => (n == null ? '—' : `$${n.toFixed(2)}`);
const fmtUnit = (p: number | null): string => (p == null ? '' : t('compare.tableUnit'));

const pageTitle = t('compare.title', { a: A.name, b: B.name });
const pageDescription = t('compare.seoDescription', { a: A.name, b: B.name });

// ---- JSON-LD（Phase 9.3）：两个 SoftwareApplication + BreadcrumbList ----
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const softwareLd = (m: typeof A) => ({
  '@type': 'SoftwareApplication',
  name: m.name,
  description: m.description || undefined,
  applicationCategory: 'AI Model',
  operatingSystem: 'Cloud API',
  brand: { '@type': 'Organization', name: m.providerName },
  offers: m.inputPrice != null
    ? {
        '@type': 'Offer',
        price: m.inputPrice,
        priceCurrency: m.currency,
        description: 'Input price per 1M tokens',
      }
    : undefined,
});
const breadcrumbLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('site.title'),
      item: new URL(`/${lang}/`, siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('compare.pageTitle'),
      item: new URL(`/${lang}/compare/`, siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pageTitle,
      item: canonicalUrl,
    },
  ],
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [softwareLd(A), softwareLd(B), breadcrumbLd],
};

// ---- Data Reliability（Phase 11.5A：benchmark/pricing 可信状态）----
const reliOf = (m: typeof A) => {
  const bConf = (m.benchmarks ?? []).map((b) => b.confidence).filter((c): c is number => c != null);
  const benchConf = bConf.length > 0 ? Math.round(bConf.reduce((a, b) => a + b, 0) / bConf.length) : null;
  const pConf = (m.pricingHistory ?? []).map((p) => p.confidence).filter((c): c is number => c != null);
  const pricingConf = pConf.length > 0 ? Math.round(pConf.reduce((a, b) => a + b, 0) / pConf.length) : null;
  const bStatus = benchConf != null && benchConf >= 90 ? 'verified' : benchConf != null && benchConf >= 70 ? 'trusted' : 'experimental';
  const pStatus = pricingConf != null && pricingConf >= 90 ? 'verified' : pricingConf != null && pricingConf >= 70 ? 'trusted' : 'experimental';
  return { name: m.name, benchConf, pricingConf, bStatus, pStatus };
};
const relA = reliOf(A);
const relB = reliOf(B);
// Phase 11.7：整体数据置信度（模型 confidenceScore，用于 Confidence Difference 展示）
const confA = (A as { confidenceScore?: number | null }).confidenceScore ?? (relA.benchConf ?? relA.pricingConf ?? 50);
const confB = (B as { confidenceScore?: number | null }).confidenceScore ?? (relB.benchConf ?? relB.pricingConf ?? 50);

// ---- FAQ（GEO：数据驱动——综合评分/价格/能力差异，禁止 mock）----
const faqCapLabel = (row: (typeof CAPABILITY_ROWS)[number]) => t(`compare.${row.labelKey}` as keyof typeof t);
const faqCapsA = new Set((A.capabilities ?? []).filter((c) => c.supported).map((c) => c.capability));
const faqCapsB = new Set((B.capabilities ?? []).filter((c) => c.supported).map((c) => c.capability));
const faqOnlyA = CAPABILITY_ROWS.filter((r) => faqCapsA.has(r.capability) && !faqCapsB.has(r.capability)).map(faqCapLabel);
const faqOnlyB = CAPABILITY_ROWS.filter((r) => faqCapsB.has(r.capability) && !faqCapsA.has(r.capability)).map(faqCapLabel);
const faqDiffParts: string[] = [];
if (faqOnlyA.length > 0) faqDiffParts.push(`${A.name}: ${faqOnlyA.join(', ')}`);
if (faqOnlyB.length > 0) faqDiffParts.push(`${B.name}: ${faqOnlyB.join(', ')}`);
const faqDiffText =
  faqDiffParts.length > 0 ? faqDiffParts.join('; ') : t('faq.compareCapability.aNone', { a: A.name, b: B.name });

const faqQuestions = [  {
    question: t('faq.compareBetter.q', { a: A.name, b: B.name }),
    answer:
      A.ranking?.overall != null && B.ranking?.overall != null
        ? t('faq.compareBetter.a', {
            winner: A.ranking.overall >= B.ranking.overall ? A.name : B.name,
            sa: String(Math.max(A.ranking.overall, B.ranking.overall)),
            sb: String(Math.min(A.ranking.overall, B.ranking.overall)),
          })
        : t('faq.compareBetter.aNone', { a: A.name, b: B.name }),
  },
  {
    question: t('faq.compareCheaper.q', { a: A.name, b: B.name }),
    answer:
      A.inputPrice != null && B.inputPrice != null
        ? t('faq.compareCheaper.a', {
            cheaper: A.inputPrice <= B.inputPrice ? A.name : B.name,
            pa: String(Math.min(A.inputPrice, B.inputPrice)),
            pb: String(Math.max(A.inputPrice, B.inputPrice)),
          })
        : t('faq.compareCheaper.aNone', { a: A.name, b: B.name }),
  },
  {
    question: t('faq.compareCapability.q', { a: A.name, b: B.name }),
    answer: faqDiffText,
  },
];

// ---- 能力矩阵（Phase 9.3）：数据来自 D1 model_capabilities；function_calling 展示为 Tools ----
const capsA = capabilityMap(A.capabilities);
const capsB = capabilityMap(B.capabilities);
const capLabel = (labelKey: string) => t(`compare.${labelKey}` as keyof typeof t);

// ---- 对比行（标签 → [A 值, B 值]）----
const rows: { label: string; a: string; b: string }[] = [
  { label: t('compare.tableProvider'), a: A.providerName, b: B.providerName },
  { label: t('compare.tableContext'), a: fmtNumber(A.contextWindow), b: fmtNumber(B.contextWindow) },
  { label: t('compare.tableRelease'), a: A.releaseDate ?? '—', b: B.releaseDate ?? '—' },
  {
    label: t('compare.tableInput'),
    a: `${fmtPrice(A.inputPrice)}${fmtUnit(A.inputPrice)}`,
    b: `${fmtPrice(B.inputPrice)}${fmtUnit(B.inputPrice)}`,
  },
  {
    label: t('compare.tableOutput'),
    a: `${fmtPrice(A.outputPrice)}${fmtUnit(A.outputPrice)}`,
    b: `${fmtPrice(B.outputPrice)}${fmtUnit(B.outputPrice)}`,
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  {/* FAQPage JSON-LD（独立 block，与主 @graph 不冲突） */}
  <FAQSchema slot="head" questions={faqQuestions} />
  <article class="mx-auto max-w-4xl">
    <a href={`/${lang}/compare/`} class="text-sm text-sky-400 transition-colors hover:text-sky-300">
      ← {t('compare.backToCompare')}
    </a>

    <h1 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">{pageTitle}</h1>

    {/* 对比表：移动端横向滚动 */}
    <div class="mt-6 overflow-x-auto rounded-xl border border-slate-800">
      <table class="w-full min-w-[520px] text-left text-sm">
        <thead>
          <tr class="border-b border-slate-800 bg-slate-900/80 text-slate-300">
            <th scope="col" class="w-40 px-4 py-3 font-medium text-slate-500"></th>
            <th scope="col" class="px-4 py-3 font-semibold text-sky-300">{A.name}</th>
            <th scope="col" class="px-4 py-3 font-semibold text-sky-300">{B.name}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-slate-800/60 last:border-b-0">
              <th scope="row" class="px-4 py-3 text-xs font-medium uppercase tracking-wide text-slate-500">
                {row.label}
              </th>
              <td class="px-4 py-3 text-slate-200">{row.a}</td>
              <td class="px-4 py-3 text-slate-200">{row.b}</td>
            </tr>
          ))}
          <tr class="last:border-b-0">
            <th scope="row" class="px-4 py-3 align-top text-xs font-medium uppercase tracking-wide text-slate-500">
              {t('compare.tableUseCases')}
            </th>
            <td class="px-4 py-3 text-slate-300">{A.useCases.length ? A.useCases.join(' · ') : '—'}</td>
            <td class="px-4 py-3 text-slate-300">{B.useCases.length ? B.useCases.join(' · ') : '—'}</td>
          </tr>
        </tbody>
      </table>
    </div>

    {/* 能力矩阵（Phase 9.3）：Vision/Reasoning/Coding/Audio/Tools/Long Context */}
    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
        {t('compare.capabilities')}
      </h2>
      <div class="mt-3 overflow-x-auto rounded-xl border border-slate-800">
        <table class="w-full min-w-[420px] text-left text-sm">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-900/80 text-slate-300">
              <th scope="col" class="w-40 px-4 py-3 font-medium text-slate-500"></th>
              <th scope="col" class="px-4 py-3 font-semibold text-sky-300">{A.name}</th>
              <th scope="col" class="px-4 py-3 font-semibold text-sky-300">{B.name}</th>
            </tr>
          </thead>
          <tbody>
            {CAPABILITY_ROWS.map((row) => (
              <tr class="border-b border-slate-800/60 last:border-b-0">
                <th scope="row" class="px-4 py-3 text-xs font-medium uppercase tracking-wide text-slate-500">
                  {capLabel(row.labelKey)}
                </th>
                <td class="px-4 py-3">
                  {capsA.get(row.capability) ? (
                    <span class="font-semibold text-emerald-400" title="✓">✓</span>
                  ) : (
                    <span class="text-slate-600" title="✗">✗</span>
                  )}
                </td>
                <td class="px-4 py-3">
                  {capsB.get(row.capability) ? (
                    <span class="font-semibold text-emerald-400" title="✓">✓</span>
                  ) : (
                    <span class="text-slate-600" title="✗">✗</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* Ranking Comparison（Phase 9.5）：评分公式见 docs/ranking-design.md */}
    {A.ranking && B.ranking && (
      <section class="mt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('ranking.compareTitle')}
        </h2>
        <div class="mt-3 overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full min-w-[420px] text-left text-sm">
            <thead>
              <tr class="border-b border-slate-800 bg-slate-900/80 text-slate-300">
                <th scope="col" class="w-40 px-4 py-3 font-medium text-slate-500"></th>
                <th scope="col" class="px-4 py-3 font-semibold text-sky-300">{A.name}</th>
                <th scope="col" class="px-4 py-3 font-semibold text-sky-300">{B.name}</th>
              </tr>
            </thead>
            <tbody>
              {[
                { label: t('ranking.overall'), a: A.ranking.overall, b: B.ranking.overall },
                { label: t('ranking.benchmark'), a: A.ranking.benchmark, b: B.ranking.benchmark },
                { label: t('ranking.capability'), a: A.ranking.capability, b: B.ranking.capability },
                { label: t('ranking.efficiency'), a: A.ranking.price, b: B.ranking.price },
                { label: t('ranking.context'), a: A.ranking.context, b: B.ranking.context },
              ].map((row) => (
                <tr class="border-b border-slate-800/60 last:border-b-0">
                  <th scope="row" class="px-4 py-3 text-xs font-medium uppercase tracking-wide text-slate-500">
                    {row.label}
                  </th>
                  <td class="px-4 py-3 text-right font-semibold tabular-nums text-slate-200">{row.a}</td>
                  <td class="px-4 py-3 text-right font-semibold tabular-nums text-slate-200">{row.b}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-[11px] text-slate-600">{t('ranking.methodologyText')}</p>
      </section>
    )}

    {/* Ranking Trend Comparison（Phase 9.6）：双方排名历史并排 */}
    {(A.rankingHistory.length > 0 || B.rankingHistory.length > 0) && (
      <section class="mt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('trend.compareTitle')}
        </h2>
        <div class="mt-3 overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full min-w-[420px] text-left text-sm">
            <thead>
              <tr class="border-b border-slate-800 bg-slate-900/80 text-slate-300">
                <th scope="col" class="w-40 px-4 py-3 font-medium text-slate-500">{t('snapshot.date')}</th>
                <th scope="col" class="px-4 py-3 font-semibold text-sky-300">{A.name}</th>
                <th scope="col" class="px-4 py-3 font-semibold text-sky-300">{B.name}</th>
              </tr>
            </thead>
            <tbody>
              {Array.from(
                new Set([...A.rankingHistory.map((h) => h.date), ...B.rankingHistory.map((h) => h.date)]),
              )
                .sort()
                .map((date) => {
                  const a = A.rankingHistory.find((h) => h.date === date);
                  const b = B.rankingHistory.find((h) => h.date === date);
                  return (
                    <tr class="border-b border-slate-800/60 last:border-b-0">
                      <th scope="row" class="px-4 py-2.5 text-xs text-slate-500">{date}</th>
                      <td class="px-4 py-2.5 text-right tabular-nums text-slate-200">
                        {a ? `#${a.rank}` : '—'}
                      </td>
                      <td class="px-4 py-2.5 text-right tabular-nums text-slate-200">
                        {b ? `#${b.rank}` : '—'}
                      </td>
                    </tr>
                  );
                })}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {/* Benchmark Comparison（Phase 9.4b）：同 dataset/version 才比较，缺失 '—' */}
    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
        {t('benchmark.compareTitle')}
      </h2>
      <div class="mt-3 overflow-x-auto rounded-xl border border-slate-800">
        <table class="w-full min-w-[420px] text-left text-sm">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-900/80 text-slate-300">
              <th scope="col" class="w-40 px-4 py-3 font-medium text-slate-500"></th>
              <th scope="col" class="px-4 py-3 font-semibold text-sky-300">{A.name}</th>
              <th scope="col" class="px-4 py-3 font-semibold text-sky-300">{B.name}</th>
            </tr>
          </thead>
          <tbody>
            {benchmarkCompareRows.map((row) => (
              <tr class="border-b border-slate-800/60 last:border-b-0">
                <th scope="row" class="px-4 py-3 text-xs font-medium uppercase tracking-wide text-slate-500">
                  {t(row.labelKey as keyof typeof t)}
                </th>
                <td class="px-4 py-3 text-right tabular-nums text-slate-200">{row.a}</td>
                <td class="px-4 py-3 text-right tabular-nums text-slate-200">{row.b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* 价格趋势（Phase 9.3）：历史 input/output 价格 */}
    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
        {t('compare.priceHistory')}
      </h2>
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        {[A, B].map((m) => (
          <div class="overflow-x-auto rounded-xl border border-slate-800">
            <p class="border-b border-slate-800 bg-slate-900/80 px-4 py-2.5 text-xs font-semibold text-sky-300">
              {m.name}
            </p>
            {m.pricingHistory.length > 0 ? (
              <table class="w-full min-w-[220px] text-left text-sm">
                <thead>
                  <tr class="border-b border-slate-800/60 text-[11px] uppercase tracking-wide text-slate-500">
                    <th scope="col" class="px-4 py-2 font-medium">{t('compare.priceDate')}</th>
                    <th scope="col" class="px-4 py-2 text-right font-medium">{t('compare.priceInput')}</th>
                    <th scope="col" class="px-4 py-2 text-right font-medium">{t('compare.priceOutput')}</th>
                  </tr>
                </thead>
                <tbody>
                  {m.pricingHistory.map((h) => (
                    <tr class="border-b border-slate-800/40 last:border-b-0">
                      <td class="px-4 py-2 text-slate-400">{h.effectiveDate}</td>
                      <td class="px-4 py-2 text-right tabular-nums text-slate-200">
                        ${h.inputPrice.toFixed(2)}
                      </td>
                      <td class="px-4 py-2 text-right tabular-nums text-slate-200">
                        ${h.outputPrice.toFixed(2)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <p class="px-4 py-4 text-sm text-slate-500">{t('compare.noHistory')}</p>
            )}
            <p class="border-t border-slate-800/40 px-4 py-1.5 text-[11px] text-slate-600">
              {t('compare.priceUnit')}
            </p>
          </div>
        ))}
      </div>
    </section>

    {/* 描述对比（可选展示） */}
    {(A.description || B.description) && (
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {A.description && (
          <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
            <h2 class="text-sm font-semibold text-sky-300">{A.name}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{A.description}</p>
          </div>
        )}
        {B.description && (
          <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
            <h2 class="text-sm font-semibold text-sky-300">{B.name}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{B.description}</p>
          </div>
        )}
      </div>
    )}

    {/* Data Reliability（Phase 11.5A）+ Confidence Difference（Phase 11.7） */}
    <section class="mt-6 grid gap-3 sm:grid-cols-2">
      {[
        { r: relA, conf: confA },
        { r: relB, conf: confB },
      ].map(({ r, conf }) => (
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
          <h2 class="text-sm font-semibold text-sky-300">{r.name}</h2>
          <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-slate-400">{t('trust.reliability')}</p>
          <div class="mt-2 flex flex-wrap gap-2">
            <DataTrustBadge confidence={r.benchConf} status={r.bStatus} label={`${t('source.benchmark')} · ${r.bStatus === 'verified' ? t('verification.verified') : r.bStatus === 'trusted' ? t('confidence.trusted') : t('verification.experimental')}`} />
            <DataTrustBadge confidence={r.pricingConf} status={r.pStatus} label={`${t('source.official')} · ${r.pStatus === 'verified' ? t('verification.verified') : r.pStatus === 'trusted' ? t('confidence.trusted') : t('verification.experimental')}`} />
          </div>
          <p class="mt-3 border-t border-slate-800 pt-2 text-xs text-slate-400">
            {t('trust.confidenceDiff')}: <span class="font-semibold text-slate-200">{conf}%</span>
          </p>
        </div>
      ))}
    </section>

    {/* FAQ（GEO：数据驱动问答区块，与 FAQPage JSON-LD 一致） */}
    <section class="mt-10 border-t border-slate-800 pt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('faq.title')}</h2>
      <div class="mt-4 space-y-3">
        {faqQuestions.map((q) => (
          <details class="group rounded-xl border border-slate-800 bg-slate-900/60 p-4">
            <summary class="cursor-pointer text-sm font-semibold text-white transition-colors group-hover:text-sky-300">
              {q.question}
            </summary>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{q.answer}</p>
          </details>
        ))}
      </div>
      {/* Related links（Phase 11.5：补齐 ranking 内链） */}
      <div class="mt-4 flex flex-wrap gap-2">
        <a
          href={`/${lang}/ranking/`}
          class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
        >
          {t('internalLinks.leaderboard')} →
        </a>
        <a
          href={`/${lang}/benchmarks/`}
          class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
        >
          {t('internalLinks.benchmarks')} →
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
