---
/**
 * AI 模型排名页：/{lang}/ranking/
 *
 * SSG：数据来自构建期 D1 导出 model-catalog.json（ranking 字段，公式见 docs/ranking-design.md）。
 * 展示：Rank / Model / Score / Benchmark / Price / Capability（按 Overall Score 降序）。
 * 移动端：横向滚动 + sticky 表头 + 卡片模式。
 * SEO：CollectionPage + ItemList JSON-LD；行链接到比较页 /{lang}/compare/。
 */
import { LOCALES } from '../../../i18n/locales';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useI18n } from '../../../i18n/ui';
import { BENCHMARK_CATEGORIES } from '../../../lib/benchmark';
import { MODEL_SLUGS } from '../../../generated/model-slugs';
import catalogJson from '../../../generated/model-catalog.json';

// Astro 7 要求动态段显式声明参数列表
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

interface CatalogEntry {
  slug: string;
  providerName: string;
  translations: Partial<Record<string, { name?: string } | undefined>>;
  ranking?: { overall: number; benchmark: number; capability: number; price: number; context: number };
  trend?: { rankChange: number | null; scoreChange: number | null } | null;
}
const catalog = catalogJson as Record<string, CatalogEntry>;

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);

interface RankRow {
  rank: number;
  slug: string;
  name: string;
  providerName: string;
  ranking: NonNullable<CatalogEntry['ranking']>;
  trend: CatalogEntry['trend'];
}
const rows: RankRow[] = [];
for (const slug of MODEL_SLUGS) {
  const m = catalog[slug];
  if (!m?.ranking) continue;
  const tr = m.translations[lang] ?? m.translations.en ?? {};
  rows.push({
    rank: 0,
    slug: m.slug,
    name: tr.name ?? m.slug,
    providerName: m.providerName,
    ranking: m.ranking,
    trend: m.trend ?? null,
  });
}
rows.sort((a, b) => b.ranking.overall - a.ranking.overall);
rows.forEach((r, i) => (r.rank = i + 1));

// Phase 11.8：Knowledge Graph —— Top 模型的 Similar choices（来自 catalog.relationships）
const topModelEntry = rows[0];
const topRelationships = topModelEntry ? (catalog[topModelEntry.slug] as { relationships?: { type: string; model: string; name: string; confidence: number }[] }).relationships ?? [] : [];
const topSimilar = topRelationships.filter((r) => r.type === 'similar_to').slice(0, 3);

// 趋势符号：正 = 上升 ↑（emerald）；负 = 下降 ↓（amber）；无/不变 = 稳定 →（slate）
const trendSymbol = (change: number | null | undefined): string => {
  if (change == null) return '→';
  if (change > 0) return '↑';
  if (change < 0) return '↓';
  return '→';
};
const trendClass = (change: number | null | undefined): string => {
  if (change == null || change === 0) return 'text-slate-500';
  return change > 0 ? 'text-emerald-400' : 'text-amber-400';
};

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: t('ranking.pageTitle'),
      description: t('ranking.subtitle'),
      url: pageUrl,
    },
    {
      '@type': 'ItemList',
      name: t('ranking.pageTitle'),
      itemListElement: rows.map((r, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: r.name,
        item: new URL(`/${lang}/models/${r.slug}/`, siteUrl).href,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('site.title'), item: new URL(`/${lang}/`, siteUrl).href },
        { '@type': 'ListItem', position: 2, name: t('ranking.pageTitle'), item: pageUrl },
      ],
    },
  ],
};

// Related Benchmarks（Phase 10.5）：分类排行榜 → 对应 Benchmark
---

<BaseLayout title={t('ranking.pageTitle')} description={t('ranking.subtitle')} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl">
    <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{t('ranking.pageTitle')}</h1>
    <p class="mt-2 text-sm text-slate-400">{t('ranking.subtitle')}</p>
    <p class="mt-1 text-xs text-slate-600">{t('ranking.methodologyText')}</p>

    {/* 表格模式（md 及以上） */}
    <div class="mt-6 hidden overflow-x-auto rounded-xl border border-slate-800 md:block">
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead class="sticky top-0 z-10">
          <tr class="border-b border-slate-800 bg-slate-900 text-[11px] uppercase tracking-wide text-slate-500">
            <th scope="col" class="px-4 py-3 font-medium">{t('ranking.rank')}</th>
            <th scope="col" class="px-4 py-3 font-medium">{t('ranking.model')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('ranking.score')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('ranking.dataConfidence')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('trend.rankChange')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('ranking.benchmark')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('ranking.efficiency')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('ranking.capability')}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-slate-800/60 last:border-b-0 hover:bg-slate-900/50">
              <td class="px-4 py-3 tabular-nums text-slate-400">{r.rank}</td>
              <td class="px-4 py-3">
                <a href={`/${lang}/models/${r.slug}/`} class="font-medium text-slate-100 hover:text-sky-300">
                  {r.name}
                </a>
              </td>
              <td class="px-4 py-3 text-right font-semibold tabular-nums text-sky-300">{r.ranking.overall}</td>
              {/* Phase 11.9：Confidence Layer（Data Confidence + Evidence sources） */}
              <td class="px-4 py-3 text-right">
                <span class="rounded-full bg-emerald-500/15 px-2 py-0.5 text-[10px] font-semibold text-emerald-400">
                  {t('ranking.dataConfidence')} {(catalog[r.slug] as { dataTrust?: { overall: number | null; sources: string[] } }).dataTrust?.overall ?? '—'}%
                </span>
                <p class="mt-0.5 text-[10px] text-slate-600">
                  {t('ranking.sourcesCount', { n: String((catalog[r.slug] as { dataTrust?: { sources: string[] } }).dataTrust?.sources?.length ?? 0) })}
                </p>
              </td>
              <td class={'px-4 py-3 text-right font-semibold tabular-nums ' + trendClass(r.trend?.rankChange)}>
                <span title={t('trend.rankChange')}>{trendSymbol(r.trend?.rankChange)}</span>
                {r.trend?.rankChange != null && r.trend.rankChange !== 0 ? Math.abs(r.trend.rankChange) : ''}
              </td>
              <td class="px-4 py-3 text-right tabular-nums text-slate-200">{r.ranking.benchmark}</td>
              <td class="px-4 py-3 text-right tabular-nums text-slate-200">{r.ranking.price}</td>
              <td class="px-4 py-3 text-right tabular-nums text-slate-200">{r.ranking.capability}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* Phase 11.8：Related Models（Knowledge Graph Similar choices） */}
    {topModelEntry && topSimilar.length > 0 && (
      <section class="mt-6 rounded-xl border border-slate-800 bg-slate-900/60 p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('graph.relatedModels')}</h2>
        <p class="mt-2 text-sm text-slate-300">
          {t('graph.similarChoices')}: <span class="font-semibold text-sky-300">{topModelEntry.name}</span>
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          {topSimilar.map((r) => (
            <a
              href={`/${lang}/models/${r.model}/`}
              class="rounded-full border border-slate-700 bg-slate-950 px-3 py-1 text-xs font-medium text-slate-200 transition-colors hover:border-sky-500/60 hover:text-white"
            >
              {r.name}
              <span class="ml-1 text-[10px] text-sky-400">{r.confidence}%</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* 卡片模式（移动端） */}
    <ul class="mt-6 space-y-3 md:hidden">
      {rows.map((r) => (
        <li class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
          <div class="flex items-baseline justify-between gap-3">
            <a href={`/${lang}/models/${r.slug}/`} class="font-semibold text-white hover:text-sky-300">
              {r.name}
            </a>
            <span class="flex items-center gap-2">
              <span class={'text-sm font-semibold tabular-nums ' + trendClass(r.trend?.rankChange)}>
                {trendSymbol(r.trend?.rankChange)}{r.trend?.rankChange != null && r.trend.rankChange !== 0 ? Math.abs(r.trend.rankChange) : ''}
              </span>
              <span class="text-lg font-bold tabular-nums text-sky-300">{r.ranking.overall}</span>
            </span>
          </div>
          <p class="text-xs text-sky-400">{r.providerName}</p>
          <dl class="mt-3 grid grid-cols-3 gap-2 text-center">
            <div class="rounded-lg bg-slate-950 px-2 py-1.5">
              <dt class="text-[10px] text-slate-500">{t('ranking.benchmark')}</dt>
              <dd class="text-xs font-medium tabular-nums text-slate-200">{r.ranking.benchmark}</dd>
            </div>
            <div class="rounded-lg bg-slate-950 px-2 py-1.5">
              <dt class="text-[10px] text-slate-500">{t('ranking.efficiency')}</dt>
              <dd class="text-xs font-medium tabular-nums text-slate-200">{r.ranking.price}</dd>
            </div>
            <div class="rounded-lg bg-slate-950 px-2 py-1.5">
              <dt class="text-[10px] text-slate-500">{t('ranking.capability')}</dt>
              <dd class="text-xs font-medium tabular-nums text-slate-200">{r.ranking.capability}</dd>
            </div>
          </dl>
        </li>
      ))}
    </ul>

    <p class="mt-4 text-center">
      <a href={`/${lang}/compare/`} class="text-sm text-sky-400 transition-colors hover:text-sky-300">
        {t('compare.pageTitle')} →
      </a>
    </p>

    {/* Related Benchmarks（Phase 10.5：内部链接增强） */}
    <section class="mt-8 border-t border-slate-800 pt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('internalLinks.relatedBenchmarks')}</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {BENCHMARK_CATEGORIES.map((cat) => (
          <a
            href={`/${lang}/benchmarks/${cat.slug}/`}
            class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
          >
            {t(cat.labelKey as keyof typeof t)} Benchmark →
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
