---
/**
 * Benchmark 分类页：/{lang}/benchmarks/[category]/
 *
 * SSG：7 语言 × 4 分类 = 28 页。数据来自构建期 D1 导出 model-catalog.json。
 * 展示：Best AI Models for {category} Benchmark —— 按 score DESC 的模型排名表
 *       （Rank / Model / Provider / Score / Dataset / Version / Date）。
 * SEO：CollectionPage JSON-LD + 本地化 title/description。
 */
import { LOCALES, type Locale } from '../../../i18n/locales';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useI18n } from '../../../i18n/ui';
import { BENCHMARK_CATEGORIES, getBenchmarkByCategory, sortByBenchmarkScore } from '../../../lib/benchmark';
import { MODEL_SLUGS } from '../../../generated/model-slugs';
import catalogJson from '../../../generated/model-catalog.json';

interface CatalogEntry {
  slug: string;
  providerName: string;
  translations: Partial<Record<string, { name?: string } | undefined>>;
  benchmarks?: {
    category: string;
    categoryName: string;
    score: number;
    rank: number | null;
    dataset: string;
    version: string;
    source: string;
    testedAt: string | null;
  }[];
}
const catalog = catalogJson as Record<string, CatalogEntry>;

// 7 语言 × 4 分类
export function getStaticPaths() {
  const paths: { params: { lang: string; category: string } }[] = [];
  for (const lang of LOCALES) {
    for (const cat of BENCHMARK_CATEGORIES) {
      paths.push({ params: { lang, category: cat.slug } });
    }
  }
  return paths;
}

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);
const categorySlug = Astro.params.category as string;
const categoryDef = BENCHMARK_CATEGORIES.find((c) => c.slug === categorySlug);

// 非法分类 → 404
if (!categoryDef) {
  return Astro.redirect('/404');
}

// 组装该分类下的模型排名（按 score DESC）
interface RankRow {
  rank: number;
  slug: string;
  name: string;
  providerName: string;
  score: number;
  dataset: string;
  version: string;
  testedAt: string | null;
}
const rows: RankRow[] = [];
for (const slug of MODEL_SLUGS) {
  const m = catalog[slug];
  if (!m) continue;
  const results = getBenchmarkByCategory(m.benchmarks ?? [], categorySlug);
  if (results.length === 0) continue;
  const best = sortByBenchmarkScore(results)[0]; // 同类别多条取最高分
  const tr = m.translations[lang] ?? m.translations.en ?? {};
  rows.push({
    rank: 0,
    slug: m.slug,
    name: tr.name ?? m.slug,
    providerName: m.providerName,
    score: best.score,
    dataset: best.dataset,
    version: best.version,
    testedAt: best.testedAt,
  });
}
rows.sort((a, b) => b.score - a.score);
rows.forEach((r, i) => (r.rank = i + 1));

const categoryLabel = t(categoryDef.labelKey as keyof typeof t);
const pageTitle = t('benchmark.bestTitle', { category: categoryLabel });
const pageDescription = t('benchmark.bestDescription', { category: categoryLabel });

// JSON-LD：CollectionPage
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: new URL(Astro.url.pathname, siteUrl).href,
};
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl">
    <a href={`/${lang}/benchmarks/`} class="text-sm text-sky-400 transition-colors hover:text-sky-300">
      ← {t('benchmark.pageTitle')}
    </a>

    <h1 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">{pageTitle}</h1>
    <p class="mt-2 text-sm text-slate-400">{pageDescription}</p>

    <div class="mt-6 overflow-x-auto rounded-xl border border-slate-800">
      <table class="w-full min-w-[560px] text-left text-sm">
        <thead class="sticky top-0 z-10">
          <tr class="border-b border-slate-800 bg-slate-900 text-[11px] uppercase tracking-wide text-slate-500">
            <th scope="col" class="px-4 py-3 font-medium">{t('leaderboard.rank')}</th>
            <th scope="col" class="px-4 py-3 font-medium">{t('leaderboard.model')}</th>
            <th scope="col" class="px-4 py-3 font-medium">{t('leaderboard.provider')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('benchmark.score')}</th>
            <th scope="col" class="px-4 py-3 font-medium">{t('benchmark.dataset')}</th>
            <th scope="col" class="px-4 py-3 font-medium">{t('benchmark.version')}</th>
            <th scope="col" class="px-4 py-3 font-medium">{t('benchmark.date')}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-slate-800/60 last:border-b-0">
              <td class="px-4 py-3 tabular-nums text-slate-400">{r.rank}</td>
              <td class="px-4 py-3">
                <a href={`/${lang}/models/${r.slug}/`} class="font-medium text-slate-100 hover:text-sky-300">
                  {r.name}
                </a>
              </td>
              <td class="px-4 py-3 text-slate-400">{r.providerName}</td>
              <td class="px-4 py-3 text-right font-semibold tabular-nums text-slate-100">{r.score}</td>
              <td class="px-4 py-3 text-slate-400">{r.dataset}</td>
              <td class="px-4 py-3 text-slate-400">{r.version}</td>
              <td class="px-4 py-3 text-slate-500">{r.testedAt ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</BaseLayout>
