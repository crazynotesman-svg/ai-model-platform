---
/**
 * Benchmark 分类页：/{lang}/benchmarks/[category]/
 *
 * SSG：7 语言 × 4 分类 = 28 页。数据来自构建期 D1 导出 model-catalog.json。
 * 展示：Best AI Models for {category} Benchmark —— 按 score DESC 的模型排名表
 *       （Rank / Model / Provider / Score / Dataset / Version / Date）。
 * SEO：CollectionPage JSON-LD + 本地化 title/description。
 */
import { LOCALES, type Locale } from '../../../i18n/locales';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useI18n } from '../../../i18n/ui';
import { BENCHMARK_CATEGORIES, getBenchmarkByCategory, sortByBenchmarkScore } from '../../../lib/benchmark';
import { MODEL_SLUGS } from '../../../generated/model-slugs';
import catalogJson from '../../../generated/model-catalog.json';

interface CatalogEntry {
  slug: string;
  providerName: string;
  translations: Partial<Record<string, { name?: string } | undefined>>;
  benchmarks?: {
    category: string;
    categoryName: string;
    score: number;
    rank: number | null;
    dataset: string;
    version: string;
    source: string;
    testedAt: string | null;
  }[];
}
const catalog = catalogJson as Record<string, CatalogEntry>;

// 7 语言 × 4 分类
export function getStaticPaths() {
  const paths: { params: { lang: string; category: string } }[] = [];
  for (const lang of LOCALES) {
    for (const cat of BENCHMARK_CATEGORIES) {
      paths.push({ params: { lang, category: cat.slug } });
    }
  }
  return paths;
}

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);
const categorySlug = Astro.params.category as string;
const categoryDef = BENCHMARK_CATEGORIES.find((c) => c.slug === categorySlug);

// 非法分类 → 404
if (!categoryDef) {
  return Astro.redirect('/404');
}

// 组装该分类下的模型排名（按 score DESC）
interface RankRow {
  rank: number;
  slug: string;
  name: string;
  providerName: string;
  score: number;
  dataset: string;
  version: string;
  testedAt: string | null;
}
const rows: RankRow[] = [];
for (const slug of MODEL_SLUGS) {
  const m = catalog[slug];
  if (!m) continue;
  const results = getBenchmarkByCategory(m.benchmarks ?? [], categorySlug);
  if (results.length === 0) continue;
  const best = sortByBenchmarkScore(results)[0]; // 同类别多条取最高分
  const tr = m.translations[lang] ?? m.translations.en ?? {};
  rows.push({
    rank: 0,
    slug: m.slug,
    name: tr.name ?? m.slug,
    providerName: m.providerName,
    score: best.score,
    dataset: best.dataset,
    version: best.version,
    testedAt: best.testedAt,
  });
}
rows.sort((a, b) => b.score - a.score);
rows.forEach((r, i) => (r.rank = i + 1));

const categoryLabel = t(categoryDef.labelKey as keyof typeof t);
const pageTitle = t('benchmark.bestTitle', { category: categoryLabel });
const pageDescription = t('benchmark.bestDescription', { category: categoryLabel });

// JSON-LD：CollectionPage + BreadcrumbList（@graph，不重复）
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: pageUrl,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('site.title'), item: new URL(`/${lang}/`, siteUrl).href },
        { '@type': 'ListItem', position: 2, name: t('benchmark.pageTitle'), item: new URL(`/${lang}/benchmarks/`, siteUrl).href },
        { '@type': 'ListItem', position: 3, name: categoryLabel, item: pageUrl },
      ],
    },
  ],
};

// Related Resources（Phase 10.5）：Related Ranking + Featured Models（Top 3，SSG 静态生成）
const featuredModels = rows.slice(0, 3).map((r) => ({
  slug: r.slug,
  name: r.name,
  providerName: r.providerName,
  score: r.score,
}));
const relatedRankingHref = `/${lang}/ranking/${categorySlug}/`;
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl">
    <a href={`/${lang}/benchmarks/`} class="text-sm text-sky-400 transition-colors hover:text-sky-300">
      ← {t('benchmark.pageTitle')}
    </a>

    <h1 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">{pageTitle}</h1>
    <p class="mt-2 text-sm text-slate-400">{pageDescription}</p>

    <div class="mt-6 overflow-x-auto rounded-xl border border-slate-800">
      <table class="w-full min-w-[560px] text-left text-sm">
        <thead class="sticky top-0 z-10">
          <tr class="border-b border-slate-800 bg-slate-900 text-[11px] uppercase tracking-wide text-slate-500">
            <th scope="col" class="px-4 py-3 font-medium">{t('leaderboard.rank')}</th>
            <th scope="col" class="px-4 py-3 font-medium">{t('leaderboard.model')}</th>
            <th scope="col" class="px-4 py-3 font-medium">{t('leaderboard.provider')}</th>
            <th scope="col" class="px-4 py-3 text-right font-medium">{t('benchmark.score')}</th>
            <th scope="col" class="px-4 py-3 font-medium">{t('benchmark.dataset')}</th>
            <th scope="col" class="px-4 py-3 font-medium">{t('benchmark.version')}</th>
            <th scope="col" class="px-4 py-3 font-medium">{t('benchmark.date')}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-slate-800/60 last:border-b-0">
              <td class="px-4 py-3 tabular-nums text-slate-400">{r.rank}</td>
              <td class="px-4 py-3">
                <a href={`/${lang}/models/${r.slug}/`} class="font-medium text-slate-100 hover:text-sky-300">
                  {r.name}
                </a>
              </td>
              <td class="px-4 py-3 text-slate-400">{r.providerName}</td>
              <td class="px-4 py-3 text-right font-semibold tabular-nums text-slate-100">{r.score}</td>
              <td class="px-4 py-3 text-slate-400">{r.dataset}</td>
              <td class="px-4 py-3 text-slate-400">{r.version}</td>
              <td class="px-4 py-3 text-slate-500">{r.testedAt ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* Source Information（Phase 11.5A：数据来源透明） */}
    {rows.length > 0 && (
      <section class="mt-6 rounded-xl border border-slate-800 bg-slate-900/60 p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('trust.source')}</h2>
        <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-3">
          <div>
            <dt class="text-slate-500">{t('benchmark.dataset')}</dt>
            <dd class="mt-0.5 text-slate-300">{rows[0].dataset}</dd>
          </div>
          <div>
            <dt class="text-slate-500">{t('benchmark.version')}</dt>
            <dd class="mt-0.5 text-slate-300">{rows[0].version}</dd>
          </div>
          <div>
            <dt class="text-slate-500">{t('benchmark.date')}</dt>
            <dd class="mt-0.5 text-slate-300">{rows[0].testedAt ?? '—'}</dd>
          </div>
        </dl>
        <p class="mt-3 border-t border-slate-800 pt-3 text-[11px] text-slate-500">
          {rows[0].dataset === 'internal-demo' ? t('verification.experimental') : t('source.benchmark')}
        </p>
      </section>
    )}

    {/* Related Resources（Phase 10.5：内部链接增强） */}
    <section class="mt-8 border-t border-slate-800 pt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('internalLinks.relatedResources')}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <a
          href={relatedRankingHref}
          class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 transition-colors hover:border-sky-500/60 hover:bg-slate-900"
        >
          <span class="text-sm font-semibold text-white">{t('internalLinks.leaderboard')}</span>
          <span class="mt-1 block text-xs text-slate-500">{t('internalLinks.relatedRanking')}</span>
        </a>
        <a
          href={`/${lang}/benchmarks/`}
          class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 transition-colors hover:border-sky-500/60 hover:bg-slate-900"
        >
          <span class="text-sm font-semibold text-white">{t('internalLinks.benchmarks')}</span>
          <span class="mt-1 block text-xs text-slate-500">{t('benchmark.pageTitle')}</span>
        </a>
      </div>
      {featuredModels.length > 0 && (
        <div class="mt-3 rounded-xl border border-slate-800 bg-slate-900/60 p-4">
          <span class="text-sm font-semibold text-white">{t('internalLinks.featuredModels')}</span>
          <div class="mt-2 flex flex-wrap gap-2">
            {featuredModels.map((f) => (
              <a
                href={`/${lang}/models/${f.slug}/`}
                class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
              >
                {f.name} ({f.score}) →
              </a>
            ))}
          </div>
        </div>
      )}
      {/* Related Use Case（Phase 11.3：benchmark 分类 → 对应场景页） */}
      <div class="mt-3 rounded-xl border border-slate-800 bg-slate-900/60 p-4">
        <span class="text-sm font-semibold text-white">{t('landing.useCases')}</span>
        <div class="mt-2 flex flex-wrap gap-2">
          <a
            href={`/${lang}/use-cases/${categorySlug}/`}
            class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
          >
            {t(`useCase.${categorySlug}.title` as keyof typeof t)} →
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
