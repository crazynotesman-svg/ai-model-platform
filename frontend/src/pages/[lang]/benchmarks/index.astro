---
/**
 * Benchmark 索引页：/{lang}/benchmarks/
 *
 * SSG：展示 4 个基准分类卡片（Coding / Reasoning / Math / Vision），链接到分类 SEO 页。
 * SEO：CollectionPage JSON-LD。
 */
import { LOCALES } from '../../../i18n/locales';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useI18n } from '../../../i18n/ui';
import { BENCHMARK_CATEGORIES } from '../../../lib/benchmark';

// Astro 7 要求动态段显式声明参数列表
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t('benchmark.pageTitle'),
  description: t('benchmark.subtitle'),
  url: new URL(Astro.url.pathname, siteUrl).href,
};
---

<BaseLayout title={t('benchmark.pageTitle')} description={t('benchmark.subtitle')} jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl">
    <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{t('benchmark.pageTitle')}</h1>
    <p class="mt-2 text-sm text-slate-400">{t('benchmark.subtitle')}</p>

    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {BENCHMARK_CATEGORIES.map((cat) => (
        <li>
          <a
            href={`/${lang}/benchmarks/${cat.slug}/`}
            class="block h-full rounded-xl border border-slate-800 bg-slate-900/60 p-5 transition-colors hover:border-sky-500/60 hover:bg-slate-900"
          >
            <h2 class="text-base font-semibold text-white">{t(cat.labelKey as keyof typeof t)}</h2>
            <p class="mt-1.5 text-sm text-slate-400">
              {t('benchmark.bestDescription', { category: t(cat.labelKey as keyof typeof t) })}
            </p>
            <span class="mt-3 inline-block text-xs font-medium text-sky-400">
              {t('benchmark.viewLeaderboard')} →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
