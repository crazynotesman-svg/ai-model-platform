---
/**
 * 首页（[lang] 动态段）：/en/ /zh-CN/ ...
 *
 * 定位：让访问者第一时间了解平台是什么、能做什么、怎么用。
 * - Hero + 实时统计（模型/厂商/语言/对比页数量，构建期从 catalog 计算）
 * - 6 大功能入口（链接到各功能页，复用导航结构）
 * - 使用方式 4 步 + 数据透明承诺 + CTA
 *
 * SEO：title/description/canonical/hreflang/JSON-LD 由 BaseLayout → SEO 组件
 * 统一生成（本页不改变任何 SEO 结构，仅替换内容文案）。
 */
import { LOCALES } from '../../i18n/locales';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQSchema from '../../components/seo/FAQSchema.astro';
import { getLangFromUrl, useI18n } from '../../i18n/ui';
import { allComparePairs } from '../../lib/compare';
import { MODEL_SLUGS } from '../../generated/model-slugs';
import catalogJson from '../../generated/model-catalog.json';

// Astro 7 要求动态段显式声明参数列表
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);

// 统计数字（构建期从数据源计算，随模型库自动更新）
const catalog = catalogJson as Record<string, { providerName: string }>;
const stats = {
  models: Object.keys(catalog).length,
  providers: new Set(Object.values(catalog).map((e) => e.providerName)).size,
  languages: LOCALES.length,
  comparePages: allComparePairs(MODEL_SLUGS).length * LOCALES.length,
};
const fmt = (n: number): string => n.toLocaleString('en-US');

// 功能入口（链接 = 现有路由，不改动导航结构；覆盖 7 大 SEO 入口）
const features: { href: string; title: string; desc: string }[] = [
  { href: `/${lang}/models/`, title: t('internalLinks.models'), desc: t('home.featureModelsDesc') },
  { href: `/${lang}/compare/`, title: t('internalLinks.compare'), desc: t('home.featureCompareDesc') },
  { href: `/${lang}/ranking/`, title: t('internalLinks.leaderboard'), desc: t('home.featureRankingDesc') },
  { href: `/${lang}/benchmarks/`, title: t('internalLinks.benchmarks'), desc: t('home.featureRankingDesc') },
  { href: `/${lang}/use-cases/coding/`, title: t('landing.useCases'), desc: t('landing.useCasesDesc') },
  { href: `/${lang}/ranking/recommendations/`, title: t('internalLinks.recommendations'), desc: t('home.featureRankingDesc') },
  { href: `/${lang}/news/`, title: t('internalLinks.news'), desc: t('home.featureNewsDesc') },
];

const steps: { title: string }[] = [
  { title: t('home.howOne') },
  { title: t('home.howTwo') },
  { title: t('home.howThree') },
  { title: t('home.howFour') },
];

// 首页排行榜：静态服务端渲染（数据来自 catalog 透明评分，构建期计算，SEO 可索引）
const catalogAll = catalogJson as Record<
  string,
  { slug: string; providerName: string; ranking?: { overall: number }; translations?: Record<string, { name?: string }> }
>;
const ranked = Object.entries(catalogAll)
  .map(([slug, m]) => ({ slug, name: m.translations?.[lang]?.name ?? m.translations?.en?.name ?? slug, provider: m.providerName, score: m.ranking?.overall ?? 0 }))
  .sort((a, b) => b.score - a.score || a.slug.localeCompare(b.slug))
  .slice(0, 8);
const rankBadge = (r: number): string => {
  if (r === 1) return 'bg-amber-400/90 text-slate-950';
  if (r === 2) return 'bg-slate-300 text-slate-900';
  if (r === 3) return 'bg-orange-700/80 text-white';
  return 'bg-slate-800 text-slate-400';
};

// 首页 FAQ（GEO：真实数据驱动——top 模型来自 catalog 评分，非 mock）
const topModel = ranked[0];
const faqQuestions = [
  {
    question: t('faq.bestModel.q'),
    answer: t('faq.bestModel.a', { name: topModel?.name ?? '—', score: String(topModel?.score ?? 0) }),
  },
  { question: t('faq.howRanked.q'), answer: t('faq.howRanked.a') },
  { question: t('faq.priceUpdate.q'), answer: t('faq.priceUpdate.a') },
  { question: t('faq.benchmarkSource.q'), answer: t('faq.benchmarkSource.a') },
];

// 首页 JSON-LD：BreadcrumbList + Organization + WebSite（SearchAction 预留，@graph 单一脚本）
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t('site.title'),
          item: new URL(`/${lang}/`, siteUrl).href,
        },
      ],
    },
    {
      '@type': 'Organization',
      name: 'AI Model Platform',
      url: new URL(`/${lang}/`, siteUrl).href,
      logo: new URL('/og-default.png', siteUrl).href,
      sameAs: [],
    },
    {
      '@type': 'WebSite',
      name: 'AI Model Platform',
      url: new URL(`/${lang}/`, siteUrl).href,
      // Google Sitelinks Searchbox：站内搜索待实现（见 docs/seo-phase-10.6-report.md TODO），
      // 暂指向 /search?q={query}（返回 404 前会重定向到 /en）
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: new URL(`/${lang}/search?q={search_term_string}`, siteUrl).href,
        },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
---

<BaseLayout title={t('site.title')} description={t('site.tagline')} jsonLd={homeJsonLd}>
  {/* FAQPage JSON-LD（独立 block，与主 @graph 不冲突） */}
  <FAQSchema slot="head" questions={faqQuestions} />
  {/* Hero */}
  <section class="mx-auto max-w-4xl pt-8 text-center">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-5xl">{t('home.welcome')}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-base text-slate-300 sm:text-lg">{t('home.subtitle')}</p>
  </section>

  {/* 统计条 */}
  <section aria-label="platform stats" class="mx-auto mt-10 max-w-4xl">
    <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      {[
        { value: fmt(stats.models), label: t('home.statsModels') },
        { value: fmt(stats.providers), label: t('home.statsProviders') },
        { value: fmt(stats.languages), label: t('home.statsLanguages') },
        { value: `${fmt(stats.comparePages)}+`, label: t('home.statsPages') },
      ].map((s) => (
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 text-center">
          <dd class="text-2xl font-bold text-sky-400 sm:text-3xl">{s.value}</dd>
          <dt class="mt-1 text-xs uppercase tracking-wide text-slate-500">{s.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  {/* 排行榜（透明评分，每日更新，吸引回访）——静态 SSR 渲染，SEO 可索引 */}
  <section aria-label={t('home.rankingTitle')} class="mx-auto mt-14 max-w-5xl">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-xl font-semibold text-white sm:text-2xl">{t('home.rankingTitle')}</h2>
        <p class="mt-1 text-sm text-slate-400">{t('home.rankingSubtitle')}</p>
      </div>
      <a
        href={`/${lang}/ranking/`}
        class="rounded-full border border-slate-700 bg-slate-900 px-4 py-1.5 text-xs font-semibold text-slate-200 transition-colors hover:border-sky-500/60 hover:text-white"
      >
        {t('home.rankingViewAll')} →
      </a>
    </div>

    <ol class="mt-5 space-y-2">
      {ranked.map((e, i) => (
        <li>
          <a
            href={`/${lang}/models/${e.slug}/`}
            class="flex items-center gap-4 rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-3 transition-colors hover:border-sky-500/60 hover:bg-slate-900"
          >
            <span class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold ${rankBadge(i + 1)}`}>
              {i + 1}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-semibold text-white">{e.name}</span>
              <span class="block text-xs uppercase tracking-wide text-sky-400">{e.provider}</span>
            </span>
            <span class="hidden w-36 sm:block">
              <span class="block h-1.5 overflow-hidden rounded-full bg-slate-800">
                <span
                  class="block h-full rounded-full bg-sky-500"
                  style={`width: ${Math.min(100, Math.max(4, e.score))}%`}
                />
              </span>
            </span>
            <span class="w-14 shrink-0 text-right">
              <span class="block text-sm font-bold text-slate-100">{e.score.toFixed(1)}</span>
              <span class="block text-[10px] uppercase text-slate-500">{t('home.rankingScore')}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
    <p class="mt-4 text-center text-xs text-slate-500">
      <span class="mr-2 inline-block rounded-full bg-emerald-500/15 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-emerald-400">
        {t('home.rankingDaily')}
      </span>
      {t('home.rankingSource')}
    </p>
  </section>

  {/* 功能入口 */}
  <section class="mx-auto mt-14 max-w-5xl">
    <h2 class="text-center text-xl font-semibold text-white sm:text-2xl">{t('home.exploreTitle')}</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <a
          href={f.href}
          class="group rounded-xl border border-slate-800 bg-slate-900/60 p-5 transition-colors hover:border-sky-500/60 hover:bg-slate-900"
        >
          <h3 class="text-base font-semibold text-white transition-colors group-hover:text-sky-300">{f.title}</h3>
          <p class="mt-2 text-sm text-slate-400">{f.desc}</p>
          <p class="mt-3 text-xs font-medium text-sky-400 transition-colors group-hover:text-sky-300">→</p>
        </a>
      ))}
    </div>
  </section>

  {/* 使用方式 */}
  <section class="mx-auto mt-14 max-w-4xl">
    <h2 class="text-center text-xl font-semibold text-white sm:text-2xl">{t('home.howTitle')}</h2>
    <ol class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <li class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-sky-500/15 text-sm font-bold text-sky-400">
            {i + 1}
          </span>
          <p class="mt-3 text-sm text-slate-300">{s.title}</p>
        </li>
      ))}
    </ol>
  </section>

  {/* 数据透明承诺 */}
  <section class="mx-auto mt-14 max-w-4xl rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-950 p-8">
    <h2 class="text-lg font-semibold text-white">{t('home.transparencyTitle')}</h2>
    <p class="mt-3 text-sm leading-relaxed text-slate-400">{t('home.transparencyDesc')}</p>
  </section>

  {/* FAQ（GEO：可见问答区块，与 FAQPage JSON-LD 内容一致） */}
  <section class="mx-auto mt-14 max-w-4xl">
    <h2 class="text-center text-xl font-semibold text-white sm:text-2xl">{t('faq.title')}</h2>
    <div class="mt-6 space-y-3">
      {faqQuestions.map((q) => (
        <details class="group rounded-xl border border-slate-800 bg-slate-900/60 p-4">
          <summary class="cursor-pointer text-sm font-semibold text-white transition-colors group-hover:text-sky-300">
            {q.question}
          </summary>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{q.answer}</p>
        </details>
      ))}
    </div>
  </section>

  {/* CTA */}
  <section class="mx-auto mt-14 max-w-3xl text-center">
    <h2 class="text-xl font-semibold text-white sm:text-2xl">{t('home.readyTitle')}</h2>
    <p class="mt-2 text-sm text-slate-400">{t('home.readyDesc')}</p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a
        href={`/${lang}/models/`}
        class="rounded-full bg-sky-500 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-sky-400"
      >
        {t('home.ctaBrowse')}
      </a>
      <a
        href={`/${lang}/compare/`}
        class="rounded-full border border-slate-700 bg-slate-900 px-6 py-2.5 text-sm font-semibold text-slate-200 transition-colors hover:border-sky-500/60 hover:text-white"
      >
        {t('home.ctaCompare')}
      </a>
      <a
        href={`/${lang}/calculator/token/`}
        class="rounded-full border border-slate-700 bg-slate-900 px-6 py-2.5 text-sm font-semibold text-slate-200 transition-colors hover:border-sky-500/60 hover:text-white"
      >
        {t('home.ctaTools')}
      </a>
      <a
        href={`/${lang}/news/`}
        class="rounded-full border border-slate-700 bg-slate-900 px-6 py-2.5 text-sm font-semibold text-slate-200 transition-colors hover:border-sky-500/60 hover:text-white"
      >
        {t('home.ctaNews')}
      </a>
    </div>
  </section>
</BaseLayout>
