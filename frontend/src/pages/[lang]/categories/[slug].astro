---
/**
 * Category Landing 页：/{lang}/categories/[slug]/
 *
 * SSG：7 语言 × 4 分类 = 28 页。数据来自 model-catalog.json（seoLanding.getCategoryModels）。
 * 结构：Hero → 模型列表（表）→ FAQ。
 * JSON-LD：CollectionPage + ItemList + BreadcrumbList（主 @graph）+ FAQPage（FAQSchema）。
 */
import { LOCALES } from '../../../i18n/locales';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FAQSchema from '../../../components/seo/FAQSchema.astro';
import { getLangFromUrl, useI18n } from '../../../i18n/ui';
import { CATEGORY_SLUGS, getCategoryModels } from '../../../lib/seoLanding';
import { USE_CASE_SLUGS, INTENT_SLUGS } from '../../../lib/seoLanding';
import { qualityBadge } from '../../../lib/seoQuality';
import catalogJson from '../../../generated/model-catalog.json';

// SSG：7 语言 × 4 分类
export function getStaticPaths() {
  const paths: { params: { lang: string; slug: string } }[] = [];
  for (const lang of LOCALES) {
    for (const slug of CATEGORY_SLUGS) {
      paths.push({ params: { lang, slug } });
    }
  }
  return paths;
}

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);
const slug = Astro.params.slug as string;

// 非法分类 → 404
if (!(CATEGORY_SLUGS as readonly string[]).includes(slug)) {
  return Astro.redirect('/404');
}

const catalog = catalogJson as unknown as Record<string, never>;
const models = getCategoryModels(slug, lang, catalog);

const catLabel = t(`category.${slug}.title` as keyof typeof t);
const catDesc = t(`category.${slug}.desc` as keyof typeof t);
const pageTitle = t('landing.categoryTitle', { cat: catLabel });
const pageDescription = catDesc;

const fmtNum = (n: number | null): string => (n == null ? '—' : n.toLocaleString(lang === 'en' ? 'en-US' : lang));
const fmtPrice = (n: number | null): string => (n == null ? '—' : `$${n.toFixed(2)}`);
const priceAsc = slug === 'cheap-models' || slug === 'open-source-models';

// JSON-LD
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: pageTitle, description: pageDescription, url: pageUrl },
    {
      '@type': 'ItemList',
      name: pageTitle,
      itemListElement: models.map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: m.name,
        item: new URL(`/${lang}/models/${m.slug}/`, siteUrl).href,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('site.title'), item: new URL(`/${lang}/`, siteUrl).href },
        { '@type': 'ListItem', position: 2, name: t('landing.categories'), item: pageUrl },
      ],
    },
  ],
};

// FAQ
const top = models[0];
const faqQuestions = [
  {
    question: t('landing.faq.bestFor.q', { case: catLabel }),
    answer: t('landing.faq.bestFor.a', {
      name: top?.name ?? '—',
      case: catLabel,
      score: top?.overall != null ? String(Math.round(top.overall)) : '—',
    }),
  },
  { question: t('landing.faq.howSelected.q'), answer: t('landing.faq.howSelected.a') },
  { question: t('landing.faq.dataFresh.q'), answer: t('landing.faq.dataFresh.a') },
];

// 空数据提示
const empty = models.length === 0;

// QualityBadge（数据覆盖）
const latestVerified = Object.values(catalog as Record<string, { lastVerifiedAt: string | null }>)
  .map((m) => m.lastVerifiedAt)
  .filter((d): d is string => Boolean(d))
  .sort()
  .reverse()[0] ?? null;
const badge = qualityBadge({ modelCount: models.length, lastVerifiedAt: latestVerified });
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <FAQSchema slot="head" questions={faqQuestions} />

  <div class="mx-auto max-w-4xl">
    <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{pageTitle}</h1>
    <p class="mt-2 text-sm text-slate-400">{catDesc}</p>

    {/* QualityBadge */}
    <p class="mt-3 flex flex-wrap gap-2">
      <span class="rounded-full bg-sky-500/15 px-2.5 py-1 text-[11px] font-semibold text-sky-300">
        {t('qualityBadge.models', { n: String(badge.modelCount) })}
      </span>
      {badge.updatedYear != null && (
        <span class="rounded-full bg-emerald-500/15 px-2.5 py-1 text-[11px] font-semibold text-emerald-400">
          {t('qualityBadge.updated', { year: String(badge.updatedYear) })}
        </span>
      )}
    </p>

    {empty ? (
      <p class="mt-6 rounded-xl border border-slate-800 bg-slate-900/60 p-6 text-sm text-slate-400">
        {t('landing.empty')}
      </p>
    ) : (
      <div class="mt-6 overflow-x-auto rounded-xl border border-slate-800">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead class="bg-slate-900 text-[11px] uppercase tracking-wide text-slate-500">
            <tr class="border-b border-slate-800">
              <th scope="col" class="px-4 py-3 font-medium">{t('landing.model')}</th>
              <th scope="col" class="px-4 py-3 font-medium">{t('landing.provider')}</th>
              <th scope="col" class="px-4 py-3 text-right font-medium">{t('landing.score')}</th>
              <th scope="col" class="px-4 py-3 text-right font-medium">{t('landing.price')}</th>
              <th scope="col" class="px-4 py-3 text-right font-medium">{t('landing.context')}</th>
            </tr>
          </thead>
          <tbody>
            {models.map((m) => (
              <tr class="border-b border-slate-800/60 last:border-b-0">
                <td class="px-4 py-3">
                  <a href={`/${lang}/models/${m.slug}/`} class="font-medium text-slate-100 hover:text-sky-300">
                    {m.name}
                  </a>
                </td>
                <td class="px-4 py-3 text-slate-400">{m.providerName}</td>
                <td class="px-4 py-3 text-right font-semibold tabular-nums text-sky-300">{m.overall ?? '—'}</td>
                <td class="px-4 py-3 text-right tabular-nums text-slate-200">{fmtPrice(m.inputPrice)}</td>
                <td class="px-4 py-3 text-right tabular-nums text-slate-400">{fmtNum(m.contextWindow)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {/* FAQ */}
    <section class="mt-8 border-t border-slate-800 pt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('faq.title')}</h2>
      <div class="mt-4 space-y-3">
        {faqQuestions.map((q) => (
          <details class="group rounded-xl border border-slate-800 bg-slate-900/60 p-4">
            <summary class="cursor-pointer text-sm font-semibold text-white transition-colors group-hover:text-sky-300">
              {q.question}
            </summary>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{q.answer}</p>
          </details>
        ))}
      </div>
    </section>

    {/* 相关分类 + 场景 + Ranking（Phase 11.4：landing 互链 ≥5） */}
    <section class="mt-8 border-t border-slate-800 pt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('landing.categories')}</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {CATEGORY_SLUGS.filter((s) => s !== slug).map((s) => (
          <a
            href={`/${lang}/categories/${s}/`}
            class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
          >
            {t(`category.${s}.title` as keyof typeof t)} →
          </a>
        ))}
        <a
          href={`/${lang}/ranking/`}
          class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
        >
          {t('internalLinks.leaderboard')} →
        </a>
      </div>
      <h3 class="mt-4 text-xs font-semibold uppercase tracking-wide text-slate-500">{t('landing.useCases')}</h3>
      <div class="mt-2 flex flex-wrap gap-2">
        {USE_CASE_SLUGS.map((s) => (
          <a
            href={`/${lang}/use-cases/${s}/`}
            class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
          >
            {t(`useCase.${s}.title` as keyof typeof t)} →
          </a>
        ))}
      </div>
      <h3 class="mt-4 text-xs font-semibold uppercase tracking-wide text-slate-500">{t('landing.intents')}</h3>
      <div class="mt-2 flex flex-wrap gap-2">
        {INTENT_SLUGS.map((s) => (
          <a
            href={`/${lang}/compare-intent/${s}/`}
            class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
          >
            {t(`intent.${s}.title` as keyof typeof t)} →
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
