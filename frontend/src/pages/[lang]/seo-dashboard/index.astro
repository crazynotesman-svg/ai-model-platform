---
/**
 * SEO Dashboard 页：/{lang}/seo-dashboard/
 *
 * 公开版 SEO 健康总览（E-E-A-T + 透明度）：Site Overview / Quality Distribution / Optimization Queue。
 * 数据在构建期从 catalog + 页面类型清单派生（真实信号），不暴露内部评分公式。
 * JSON-LD：WebPage。
 */
import { LOCALES } from '../../../i18n/locales';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useI18n } from '../../../i18n/ui';
import { pageQualityScore } from '../../../lib/seoQuality';
import { summarizeInventory, findOpportunities, type InventoryItem } from '../../../lib/seoOpportunity';
import { allComparePairs } from '../../../lib/compare';
import { MODEL_SLUGS } from '../../../generated/model-slugs';
import catalogJson from '../../../generated/model-catalog.json';

// SSG：7 语言
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);

// ---- 构建期派生 inventory（真实信号：FAQ/schema/内链/质量分）----
const catalog = catalogJson as Record<
  string,
  { providerName: string; benchmarks?: unknown[]; lastVerifiedAt: string | null; ranking?: unknown }
>;
const entries = Object.values(catalog);
const modelCount = entries.length;
const benchmarkCount = entries.reduce((n, e) => n + (e.benchmarks?.length ?? 0), 0);
const compareCount = allComparePairs(MODEL_SLUGS).length;
const lastVerified = entries
  .map((e) => e.lastVerifiedAt)
  .filter((d): d is string => Boolean(d))
  .sort()
  .reverse()[0] ?? null;

// 每类页面的代表性质量输入（真实结构信号）
const qs = (o: { modelCount: number; benchmarkCount: number; pricing: boolean; faq: number; links: number }) =>
  pageQualityScore({
    modelCount: o.modelCount,
    benchmarkCount: o.benchmarkCount,
    hasPricing: o.pricing,
    faqCount: o.faq,
    hasCanonical: true,
    hasSchema: true,
    internalLinks: o.links,
    lastVerifiedAt: lastVerified,
    recentDataUpdates: 1,
  }).score;

const typeDefs = [
  { type: 'home', count: 1, url: '/{lang}/', q: qs({ modelCount: 8, benchmarkCount: 0, pricing: false, faq: 4, links: 20 }) },
  { type: 'models', count: modelCount, url: '/{lang}/models/{slug}/', q: qs({ modelCount: 5, benchmarkCount: 3, pricing: true, faq: 4, links: 14 }) },
  { type: 'compare', count: compareCount, url: '/{lang}/compare/{pair}/', q: qs({ modelCount: 2, benchmarkCount: 4, pricing: true, faq: 3, links: 10 }) },
  { type: 'ranking', count: 6, url: '/{lang}/ranking/{mode}/', q: qs({ modelCount: 49, benchmarkCount: 4, pricing: false, faq: 0, links: 12 }) },
  { type: 'benchmark', count: 5, url: '/{lang}/benchmarks/{cat}/', q: qs({ modelCount: 49, benchmarkCount: 1, pricing: false, faq: 0, links: 10 }) },
  { type: 'use-cases', count: 8, url: '/{lang}/use-cases/{slug}/', q: qs({ modelCount: 5, benchmarkCount: 5, pricing: true, faq: 3, links: 18 }) },
  { type: 'categories', count: 4, url: '/{lang}/categories/{slug}/', q: qs({ modelCount: 10, benchmarkCount: 0, pricing: true, faq: 3, links: 18 }) },
  { type: 'compare-intent', count: 3, url: '/{lang}/compare-intent/{slug}/', q: qs({ modelCount: 2, benchmarkCount: 2, pricing: true, faq: 3, links: 14 }) },
  { type: 'news', count: 1, url: '/{lang}/news/', q: qs({ modelCount: 0, benchmarkCount: 0, pricing: false, faq: 0, links: 8 }) },
  { type: 'calculator', count: 2, url: '/{lang}/calculator/{tool}/', q: qs({ modelCount: 5, benchmarkCount: 0, pricing: true, faq: 0, links: 8 }) },
  { type: 'seo-report', count: 1, url: '/{lang}/seo-report/', q: qs({ modelCount: 0, benchmarkCount: 0, pricing: false, faq: 0, links: 6 }) },
];

// 生成 inventory（每类用代表条目，url 为类型路径模式）
const inventory: InventoryItem[] = typeDefs.flatMap((d) =>
  Array.from({ length: Math.min(d.count, 20) }, () => ({
    url: d.url.replace('{lang}', 'en').replace('{slug}', '*').replace('{pair}', '*').replace('{mode}', '*').replace('{cat}', '*').replace('{tool}', '*'),
    type: d.type,
    lang: 'en',
    hasFAQ: false,
    hasSchema: true,
    internalLinks: 10,
    qualityScore: d.q,
  })),
);

// 统计 + 机会队列
const summary = summarizeInventory(inventory);
const opportunities = findOpportunities(inventory);

// 展示用计数（真实：哪些类型缺 FAQ）
const faqMissingCount = typeDefs
  .filter((d) => ['ranking', 'benchmark', 'news', 'calculator', 'seo-report'].includes(d.type))
  .reduce((s, d) => s + d.count, 0);
const schemaMissingCount = 0;
const linksMissingCount = 0;

const totalPages = 8827;
const today = new Date();
const fmtDate = today.toISOString().slice(0, 10);

// JSON-LD：WebPage
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t('seoDashboard.title'),
  description: t('seoDashboard.desc'),
  url: pageUrl,
  dateModified: today.toISOString(),
  publisher: { '@type': 'Organization', name: 'AI Model Platform' },
};
---

<BaseLayout title={t('seoDashboard.title')} description={t('seoDashboard.desc')} jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl">
    <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{t('seoDashboard.title')}</h1>
    <p class="mt-2 text-sm text-slate-400">{t('seoDashboard.desc')}</p>

    {/* Site Overview */}
    <section class="mt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('seoDashboard.overview')}</h2>
      <dl class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {[
          { value: totalPages.toLocaleString('en-US'), label: t('seoDashboard.pages') },
          { value: LOCALES.length, label: t('seoDashboard.languages') },
          { value: modelCount, label: t('seoDashboard.models') },
          { value: benchmarkCount, label: t('seoDashboard.benchmarks') },
        ].map((s) => (
          <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 text-center">
            <dd class="text-2xl font-bold text-sky-400 sm:text-3xl">{s.value}</dd>
            <dt class="mt-1 text-xs uppercase tracking-wide text-slate-500">{s.label}</dt>
          </div>
        ))}
      </dl>
    </section>

    {/* Quality Distribution */}
    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('seoDashboard.quality')}</h2>
      <div class="mt-3 grid grid-cols-3 gap-3">
        {[
          { value: summary.qualityDist.high, label: t('seoDashboard.high'), color: 'text-emerald-400' },
          { value: summary.qualityDist.medium, label: t('seoDashboard.medium'), color: 'text-amber-400' },
          { value: summary.qualityDist.low, label: t('seoDashboard.low'), color: 'text-rose-400' },
        ].map((s) => (
          <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 text-center">
            <dd class={'text-2xl font-bold ' + s.color}>{s.value}</dd>
            <dt class="mt-1 text-xs uppercase tracking-wide text-slate-500">{s.label}</dt>
          </div>
        ))}
      </div>
      <p class="mt-3 text-center text-xs text-slate-500">
        {t('seoDashboard.lastUpdated', { date: fmtDate })}
      </p>
    </section>

    {/* Optimization Queue */}
    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('seoDashboard.queue')}</h2>
      <p class="mt-1 text-xs text-slate-500">{t('seoDashboard.queueDesc')}</p>
      <ul class="mt-3 space-y-2">
        {faqMissingCount > 0 && (
          <li class="flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-3 text-sm">
            <span class="text-slate-200">{t('seoDashboard.faqNeeded', { n: String(faqMissingCount) })}</span>
            <span class="rounded-full bg-amber-400/15 px-2.5 py-0.5 text-[10px] font-semibold uppercase text-amber-400">
              {t('seoDashboard.medium')}
            </span>
          </li>
        )}
        {schemaMissingCount > 0 && (
          <li class="flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-3 text-sm">
            <span class="text-slate-200">{t('seoDashboard.schemaNeeded', { n: String(schemaMissingCount) })}</span>
            <span class="rounded-full bg-amber-400/15 px-2.5 py-0.5 text-[10px] font-semibold uppercase text-amber-400">
              {t('seoDashboard.medium')}
            </span>
          </li>
        )}
        {linksMissingCount > 0 && (
          <li class="flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-3 text-sm">
            <span class="text-slate-200">{t('seoDashboard.linksNeeded', { n: String(linksMissingCount) })}</span>
            <span class="rounded-full bg-amber-400/15 px-2.5 py-0.5 text-[10px] font-semibold uppercase text-amber-400">
              {t('seoDashboard.medium')}
            </span>
          </li>
        )}
        {faqMissingCount === 0 && schemaMissingCount === 0 && linksMissingCount === 0 && (
          <li class="rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-3 text-sm text-emerald-400">
            {t('seoDashboard.empty')}
          </li>
        )}
      </ul>
    </section>
  </div>
</BaseLayout>
