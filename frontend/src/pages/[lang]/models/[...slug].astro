---
/**
 * 模型详情页：/{lang}/models/[...slug]/
 *
 * SSG：构建期由 scripts/export-models.mjs 从本地 D1 导出数据（src/generated/），
 * 生成每个模型的静态详情页（SEO 最优）。数据与 Worker API 同源（D1）。
 *
 * 展示：名称 / Provider / Context Window / 输入输出价格 / 支持语言 / 描述 / 用途。
 */
import { LOCALES, LOCALE_LABELS, type Locale } from '../../../i18n/locales';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FAQSchema from '../../../components/seo/FAQSchema.astro';
import DataTrustBadge from '../../../components/data/DataTrustBadge.astro';
import DataFreshnessBadge from '../../../components/data/DataFreshnessBadge.astro';
import { getLangFromUrl, useI18n } from '../../../i18n/ui';
import { comparePairKey, CAPABILITY_ROWS } from '../../../lib/compare';
import { MODEL_SLUGS } from '../../../generated/model-slugs';
import catalogJson from '../../../generated/model-catalog.json';

// ---- 生成数据类型（与 scripts/export-models.mjs 输出一致）----
interface ModelCatalogEntry {
  slug: string;
  modelType: string;
  contextWindow: number | null;
  releaseDate: string | null;
  providerName: string;
  inputPrice: number | null;
  outputPrice: number | null;
  currency: string;
  unit: string;
  languages: string[];
  translations: Partial<
    Record<string, { name?: string; description?: string | null; useCases?: string[] | null }>
  >;
  capabilities?: { capability: string; supported: boolean; confidence?: number | null }[];
  benchmarks?: {
    category: string;
    categoryName: string;
    score: number;
    rank: number | null;
    dataset: string;
    version: string;
    testedAt: string | null;
    confidence?: number | null;
    sourceUrl?: string | null;
    verificationStatus?: string;
  }[];
  pricingHistory?: {
    effectiveDate: string;
    inputPrice: number;
    outputPrice: number;
    confidence?: number | null;
    sourceUrl?: string | null;
  }[];
  ranking?: { overall: number; benchmark: number; capability: number; price: number; context: number };
  trend?: { rankChange: number | null; scoreChange: number | null } | null;
  rankingHistory?: { date: string; rank: number; score: number }[];
  lastVerifiedAt: string | null;
  dataStatus: string;
  verifiedStatus?: string;
  confidenceScore?: number | null;
  relationships?: { type: string; model: string; name: string; confidence: number; reason: string }[];
  dataTrust?: { overall: number | null; sources: string[]; lastVerified: string | null; warnings: string[] };
}
const catalog = catalogJson as Record<string, ModelCatalogEntry>;

// 组合 lang × slug 的全部静态路径
export function getStaticPaths() {
  const paths: { params: { lang: string; slug: string } }[] = [];
  for (const lang of LOCALES) {
    for (const slug of MODEL_SLUGS) {
      paths.push({ params: { lang, slug } });
    }
  }
  return paths;
}

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);
const slug = Astro.params.slug as string;
const data = catalog[slug];

// 数据缺失（构建时不应发生）→ 重定向 404
if (!data) {
  return Astro.redirect('/404');
}

const tr = data.translations[lang] ?? data.translations.en ?? {};
const name = tr.name ?? data.slug;
const description = tr.description ?? '';
const useCases = tr.useCases ?? [];

// SVG 折线数据（Ranking History，Phase 9.6）
const history = data.rankingHistory ?? [];
const rankLine = (() => {
  const scores = history.map((h) => h.score);
  const min = Math.min(...scores);
  const max = Math.max(...scores);
  const range = max - min || 1;
  const W = 600;
  const H = 140;
  const PAD = 12;
  const xOf = (i: number) => (history.length <= 1 ? W / 2 : (i / (history.length - 1)) * (W - PAD * 2) + PAD);
  const yOf = (s: number) => H - PAD - ((s - min) / range) * (H - PAD * 2);
  const pointsAttr = history.map((h, i) => `${xOf(i).toFixed(1)},${yOf(h.score).toFixed(1)}`).join(' ');
  return { pointsAttr, min, max, yOf, first: history[0], last: history[history.length - 1] };
})();

const fmtNumber = (n: number | null): string =>
  n == null ? '—' : n.toLocaleString(lang === 'en' ? 'en-US' : lang);
const fmtPrice = (n: number | null): string => (n == null ? '—' : `$${n.toFixed(2)}`);

// 结构化数据（JSON-LD）：模型作为 SoftwareApplication（含应用类别/操作系统/厂商/价格）
// 结构化数据（JSON-LD）：SoftwareApplication + BreadcrumbList（@graph，避免重复）
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
// ---- Related Models（Phase 11.8 Knowledge Graph：catalog.relationships）----
const rels = data.relationships ?? [];
const similarRels = rels.filter((r) => r.type === 'similar_to');
const lowerCostRels = rels.filter((r) => r.type === 'cheaper_than');
const perfAltRels = rels.filter((r) => r.type === 'alternative_to');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name,
      description,
      applicationCategory: 'AI Model',
      operatingSystem: 'Cloud API',
      dateModified: data.lastVerifiedAt ?? undefined, // Phase 11.6：SEO freshness
      provider: { '@type': 'Organization', name: data.providerName },
      offers: {
        '@type': 'Offer',
        price: data.inputPrice ?? undefined,
        priceCurrency: data.currency,
        description: 'Input price per 1M tokens',
      },
      // Phase 11.8：isRelatedTo（指向相似模型页——有可靠 URL 才生成）
      isRelatedTo: similarRels.slice(0, 3).map((r) => ({
        '@type': 'SoftwareApplication',
        name: r.name,
        url: new URL(`/${lang}/models/${r.model}/`, siteUrl).href,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('site.title'), item: new URL(`/${lang}/`, siteUrl).href },
        { '@type': 'ListItem', position: 2, name: t('models.pageTitle'), item: new URL(`/${lang}/models/`, siteUrl).href },
        { '@type': 'ListItem', position: 3, name, item: new URL(Astro.url.pathname, siteUrl).href },
      ],
    },
  ],
};

// ---- Related Resources（SSG 静态生成，禁止 runtime API）----
// 头部模型：按 overall 评分取 Top 3（排除自身），用于"与头部模型对比"
const catalogAll = catalogJson as Record<
  string,
  {
    slug: string;
    providerName: string;
    contextWindow: number | null;
    ranking?: { overall: number };
    translations?: Partial<Record<string, { name?: string } | undefined>>;
  }
>;
const topRanked = Object.entries(catalogAll)
  .filter(([s]) => s !== data.slug)
  .map(([slug, m]) => ({ slug, name: m.translations?.[lang]?.name ?? m.translations?.en?.name ?? slug, score: m.ranking?.overall ?? 0 }))
  .sort((a, b) => b.score - a.score || a.slug.localeCompare(b.slug))
  .slice(0, 3);

// 相似模型：同 provider 优先，其次上下文相近（|Δctx| <= 20%），取 4 个
const ctx = data.contextWindow ?? 0;
const similar = Object.entries(catalogAll)
  .filter(([s]) => s !== data.slug)
  .map(([slug, m]) => {
    const mctx = m.contextWindow ?? 0;
    const sameProvider = m.providerName === data.providerName;
    const close = ctx > 0 && mctx > 0 && Math.abs(mctx - ctx) / ctx <= 0.2;
    return { slug, name: m.translations?.[lang]?.name ?? m.translations?.en?.name ?? slug, sameProvider, close };
  })
  .sort((a, b) => Number(b.sameProvider) - Number(a.sameProvider) || Number(b.close) - Number(a.close))
  .slice(0, 4);

// 对比链接（comparePairKey 自动规范化 URL）
const compareVsTop = topRanked.map((m) => ({
  href: `/${lang}/compare/${comparePairKey(data.slug, m.slug)}/`,
  name: m.name,
}));

// ---- Data Trust（Phase 11.5A：来源 + 验证 + 新鲜度 + 置信度）----
const modelVerified = data.verifiedStatus === 'verified';
const benchConfs = (data.benchmarks ?? []).map((b) => b.confidence).filter((c): c is number => c != null);
const pricingConfs = (data.pricingHistory ?? []).map((p) => p.confidence).filter((c): c is number => c != null);
const benchConf = benchConfs.length > 0 ? Math.round(benchConfs.reduce((a, b) => a + b, 0) / benchConfs.length) : null;
const pricingConf = pricingConfs.length > 0 ? Math.round(pricingConfs.reduce((a, b) => a + b, 0) / pricingConfs.length) : null;
const overallConf = data.confidenceScore ?? benchConf ?? pricingConf ?? null;
const trustRows = [
  { label: t('trust.modelVerified'), conf: modelVerified ? 95 : (data.confidenceScore ?? null), status: modelVerified ? 'verified' : data.dataStatus === 'deprecated' ? 'unverified' : 'experimental' },
  { label: t('trust.pricingVerified'), conf: pricingConf, status: pricingConf != null && pricingConf >= 90 ? 'verified' : 'experimental' },
  { label: t('trust.benchmarkVerified'), conf: benchConf, status: benchConf != null && benchConf >= 90 ? 'verified' : benchConf != null && benchConf >= 70 ? 'trusted' : 'experimental' },
];
const trustSource =
  (data.benchmarks ?? []).find((b) => b.sourceUrl)?.sourceUrl ??
  (data.pricingHistory ?? []).find((p) => p.sourceUrl)?.sourceUrl ??
  null;

// ---- Related Use Cases（Phase 11.3：该模型出现在哪些场景 Top5）----
import { USE_CASE_SLUGS, getUseCaseModels } from '../../../lib/seoLanding';
const relatedUseCases = USE_CASE_SLUGS.filter((uc) =>
  getUseCaseModels(uc, lang, catalogJson as unknown as Record<string, never>).some((m) => m.slug === data.slug),
).map((uc) => ({ slug: uc, title: t(`useCase.${uc}.title` as keyof typeof t) }));

// ---- FAQ（GEO：数据驱动，禁止 mock）----
// 支持的能力标签（用 compare.* 键本地化，7 语言）
const supportedCaps = CAPABILITY_ROWS.filter(
  (row) => (data.capabilities ?? []).find((c) => c.capability === row.capability)?.supported,
).map((row) => t(`compare.${row.labelKey}` as keyof typeof t));
const fmtCtx = (n: number | null): string => (n == null ? '—' : n.toLocaleString(lang === 'en' ? 'en-US' : lang));
const fmtUsd = (n: number | null): string => (n == null ? '—' : n.toFixed(2));
const faqQuestions = [
  {
    question: t('faq.modelWhat.q', { name }),
    answer: t('faq.modelWhat.a', { name, provider: data.providerName, description: description || data.providerName }),
  },
  {
    question: t('faq.modelContext.q', { name }),
    answer: t('faq.modelContext.a', { name, context: fmtCtx(data.contextWindow) }),
  },
  {
    question: t('faq.modelCost.q', { name }),
    answer: t('faq.modelCost.a', {
      name,
      in: fmtUsd(data.inputPrice),
      out: fmtUsd(data.outputPrice),
    }),
  },
  ...(supportedCaps.length > 0
    ? [
        {
          question: t('faq.modelCapabilities.q', { name }),
          answer: t('faq.modelCapabilities.a', { name, caps: supportedCaps.join(', ') }),
        },
      ]
    : []),
];

const detailRows: { label: string; value: string }[] = [
  { label: t('models.detailProvider'), value: data.providerName },
  { label: t('models.detailModelType'), value: data.modelType },
  { label: t('models.detailContextWindow'), value: fmtNumber(data.contextWindow) },
  {
    label: t('models.detailInputPrice'),
    value: `${fmtPrice(data.inputPrice)}${data.inputPrice != null ? t('models.unitLabel') : ''}`,
  },
  {
    label: t('models.detailOutputPrice'),
    value: `${fmtPrice(data.outputPrice)}${data.outputPrice != null ? t('models.unitLabel') : ''}`,
  },
  { label: t('models.detailReleaseDate'), value: data.releaseDate ?? '—' },
];
---

<BaseLayout title={`${name} | ${t('site.title')}`} description={description} jsonLd={jsonLd}>
  {/* FAQPage JSON-LD（独立 block，与主 @graph 不冲突） */}
  <FAQSchema slot="head" questions={faqQuestions} />
  <article class="mx-auto max-w-3xl">
    <a href={`/${lang}/models/`} class="text-sm text-sky-400 transition-colors hover:text-sky-300">
      ← {t('models.backToList')}
    </a>

    <header class="mt-4">
      <h1 class="text-3xl font-bold tracking-tight text-white">{name}</h1>
      <p class="mt-1 text-sm font-medium uppercase tracking-wide text-sky-400">
        {data.providerName}
      </p>
    </header>

    <dl class="mt-6 grid gap-px overflow-hidden rounded-xl border border-slate-800 bg-slate-800 sm:grid-cols-2">
      {detailRows.map((row) => (
        <div class="flex items-center justify-between gap-4 bg-slate-950 px-4 py-3">
          <dt class="text-sm text-slate-500">{row.label}</dt>
          <dd class="text-sm font-medium text-slate-100">{row.value}</dd>
        </div>
      ))}
    </dl>

    {/* Data Trust Card（Phase 11.5A） */}
    <section class="mt-6 rounded-xl border border-slate-800 bg-slate-900/60 p-5">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('trust.dataTrustCard')}</h2>
      <ul class="mt-3 space-y-2">
        {trustRows.map((row) => (
          <li class="flex items-center justify-between gap-3 text-sm">
            <span class="text-slate-300">{row.label}</span>
            <DataTrustBadge confidence={row.conf} status={row.status} />
          </li>
        ))}
      </ul>
      <p class="mt-3 flex items-center justify-between border-t border-slate-800 pt-3 text-sm">
        <span class="text-slate-300">{t('trust.freshness')}</span>
        <DataFreshnessBadge lastVerifiedAt={data.lastVerifiedAt} />
      </p>
      {overallConf != null && (
        <p class="mt-3 border-t border-slate-800 pt-3 text-xs text-slate-400">
          {t('trust.confidence')}: <span class="font-semibold text-slate-200">{overallConf}%</span>
        </p>
      )}
      {trustSource && (
        <p class="mt-1 text-xs text-slate-500">
          {t('trust.verifiedBy', { source: trustSource })}
        </p>
      )}
    </section>

    {/* Data History（Phase 11.7：价格/基准更新时间 + 来源） */}
    {((data.pricingHistory?.length ?? 0) > 0 || (data.benchmarks?.length ?? 0) > 0) && (
      <section class="mt-4 rounded-xl border border-slate-800 bg-slate-900/60 p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('models.evidenceTimeline')}</h2>
        <dl class="mt-3 space-y-2 text-sm">
          {(data.pricingHistory ?? []).length > 0 && (
            <div class="flex items-center justify-between gap-3">
              <dt class="text-slate-400">{t('trust.priceUpdated')}</dt>
              <dd class="tabular-nums text-slate-200">
                {(data.pricingHistory ?? [])[(data.pricingHistory ?? []).length - 1].effectiveDate}
              </dd>
            </div>
          )}
          {(data.benchmarks ?? []).length > 0 && (
            <div class="flex items-center justify-between gap-3">
              <dt class="text-slate-400">{t('trust.benchmarkVerified')}</dt>
              <dd class="tabular-nums text-slate-200">
                {(data.benchmarks ?? [])
                  .map((b) => b.testedAt)
                  .filter((d): d is string => Boolean(d))
                  .sort()
                  .reverse()[0] ?? '—'}
              </dd>
            </div>
          )}
          {trustSource && (
            <div class="flex items-center justify-between gap-3">
              <dt class="text-slate-400">{t('trust.source')}</dt>
              <dd class="max-w-[60%] truncate text-right text-xs text-slate-300">{trustSource}</dd>
            </div>
          )}
          {(data.dataTrust?.sources?.length ?? 0) > 0 && (
            <div class="flex items-center justify-between gap-3">
              <dt class="text-slate-400">{t('models.evidenceSources', { n: String((data.dataTrust?.sources ?? []).length) })}</dt>
              <dd class="text-xs text-slate-300">
                {data.dataTrust?.overall != null ? `${t('trust.confidence')}: ${data.dataTrust.overall}%` : '—'}
              </dd>
            </div>
          )}
        </dl>
      </section>
    )}

    {/* Related Models（Phase 11.8 Knowledge Graph：Similar + Alternatives，reason+confidence） */}
    {(similarRels.length > 0 || lowerCostRels.length > 0 || perfAltRels.length > 0) && (
      <section class="mt-6 rounded-xl border border-slate-800 bg-slate-900/60 p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('graph.relatedModels')}</h2>
        {similarRels.length > 0 && (
          <div class="mt-3">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-sky-400">{t('graph.similarModels')}</h3>
            <ul class="mt-2 space-y-2">
              {similarRels.slice(0, 4).map((r) => (
                <li class="rounded-lg border border-slate-800 bg-slate-950/60 p-3">
                  <a href={`/${lang}/models/${r.model}/`} class="text-sm font-semibold text-slate-100 hover:text-sky-300">
                    {r.name}
                  </a>
                  <span class="ml-2 rounded-full bg-sky-500/15 px-2 py-0.5 text-[10px] font-semibold text-sky-300">
                    {t('graph.confidence')} {r.confidence}%
                  </span>
                  <p class="mt-1 text-[11px] text-slate-500">{r.reason}</p>
                </li>
              ))}
            </ul>
          </div>
        )}
        {(lowerCostRels.length > 0 || perfAltRels.length > 0) && (
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {lowerCostRels.length > 0 && (
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-wide text-emerald-400">{t('graph.lowerCost')}</h3>
                <ul class="mt-2 space-y-1.5">
                  {lowerCostRels.slice(0, 3).map((r) => (
                    <li>
                      <a href={`/${lang}/models/${r.model}/`} class="text-xs font-medium text-slate-200 hover:text-sky-300">{r.name}</a>
                      <p class="text-[10px] text-slate-500">{r.reason}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {perfAltRels.length > 0 && (
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-wide text-sky-400">{t('graph.higherPerf')}</h3>
                <ul class="mt-2 space-y-1.5">
                  {perfAltRels.slice(0, 3).map((r) => (
                    <li>
                      <a href={`/${lang}/models/${r.model}/`} class="text-xs font-medium text-slate-200 hover:text-sky-300">{r.name}</a>
                      <p class="text-[10px] text-slate-500">{r.reason}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}
        <p class="mt-3 border-t border-slate-800 pt-2 text-[10px] text-slate-600">{t('graph.engineComputed')}</p>
      </section>
    )}

    {description && (
      <section class="mt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('models.detailDescription')}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-300">{description}</p>
      </section>
    )}

    {useCases.length > 0 && (
      <section class="mt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('models.detailUseCases')}
        </h2>
        <ul class="mt-2 flex flex-wrap gap-2">
          {useCases.map((c) => (
            <li
              class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-xs text-slate-300"
            >
              {c}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Data Status Card（Phase 9.7）：数据核验状态透明展示 */}
    <section class="mt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
        {t('model.dataStatusTitle')}
      </h2>
      <dl class="mt-2 grid gap-px overflow-hidden rounded-xl border border-slate-800 bg-slate-800 sm:grid-cols-2">
        <div class="flex items-center justify-between gap-4 bg-slate-950 px-4 py-3">
          <dt class="text-sm text-slate-500">{t('model.status')}</dt>
          <dd
            class={
              'rounded-full px-2.5 py-0.5 text-xs font-medium ' +
              (data.dataStatus === 'active'
                ? 'bg-emerald-500/15 text-emerald-300'
                : data.dataStatus === 'deprecated'
                  ? 'bg-amber-500/15 text-amber-300'
                  : 'bg-slate-500/15 text-slate-300')
            }
          >
            {t(
              (data.dataStatus === 'active'
                ? 'model.statusActive'
                : data.dataStatus === 'deprecated'
                  ? 'model.statusDeprecated'
                  : 'model.statusRetired') as keyof typeof t,
            )}
          </dd>
        </div>
        <div class="flex items-center justify-between gap-4 bg-slate-950 px-4 py-3">
          <dt class="text-sm text-slate-500">{t('model.lastVerified')}</dt>
          <dd class="text-sm font-medium text-slate-100">
            {data.lastVerifiedAt ?? t('model.neverVerified')}
          </dd>
        </div>
      </dl>
    </section>

    {/* Overall Ranking Card（Phase 9.5）：评分公式见 docs/ranking-design.md */}
    {data.ranking && (
      <section class="mt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('ranking.resultsTitle')}
        </h2>
        <div class="mt-2 grid gap-2 sm:grid-cols-5">
          <div class="rounded-xl border border-sky-500/40 bg-sky-500/10 p-4 text-center">
            <p class="text-[11px] uppercase tracking-wide text-sky-400">{t('ranking.overall')}</p>
            <p class="mt-1 text-2xl font-bold tabular-nums text-white">{data.ranking.overall}</p>
          </div>
          {[
            { label: t('ranking.benchmark'), value: data.ranking.benchmark },
            { label: t('ranking.capability'), value: data.ranking.capability },
            { label: t('ranking.efficiency'), value: data.ranking.price },
            { label: t('ranking.context'), value: data.ranking.context },
          ].map((item) => (
            <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 text-center">
              <p class="text-[11px] uppercase tracking-wide text-slate-500">{item.label}</p>
              <p class="mt-1 text-xl font-semibold tabular-nums text-slate-100">{item.value}</p>
            </div>
          ))}
        </div>
        <p class="mt-2 text-[11px] text-slate-600">{t('ranking.methodologyText')}</p>
      </section>
    )}

    {/* Ranking History 折线图（Phase 9.6）：轻量 SVG，最近 30 天 overall 分数 */}
    {(data.rankingHistory ?? []).length >= 2 && (
      <section class="mt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('snapshot.title')}
          <span class="ml-2 text-[10px] normal-case tracking-normal text-slate-600">
            {t('snapshot.last30')}
          </span>
        </h2>
        <div class="mt-2 overflow-x-auto rounded-xl border border-slate-800 bg-slate-950 p-3">
          <svg viewBox="0 0 600 160" role="img" class="h-auto w-full min-w-[420px]" aria-label={t('snapshot.title')}>
            <line x1="0" y1={rankLine.yOf(rankLine.max)} x2="600" y2={rankLine.yOf(rankLine.max)} class="stroke-slate-800" stroke-width="1" stroke-dasharray="4 4" />
            <line x1="0" y1={rankLine.yOf(rankLine.min)} x2="600" y2={rankLine.yOf(rankLine.min)} class="stroke-slate-800" stroke-width="1" stroke-dasharray="4 4" />
            <polyline points={rankLine.pointsAttr} fill="none" stroke="#38bdf8" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
            <text x="4" y={rankLine.yOf(rankLine.max) - 4} class="fill-slate-500" font-size="10">{rankLine.max}</text>
            <text x="4" y={rankLine.yOf(rankLine.min) + 12} class="fill-slate-500" font-size="10">{rankLine.min}</text>
            <text x="4" y="152" class="fill-slate-600" font-size="9">{rankLine.first.date}</text>
            <text x="596" y="152" text-anchor="end" class="fill-slate-600" font-size="9">{rankLine.last.date}</text>
          </svg>
        </div>
      </section>
    )}

    {/* Benchmark Results（Phase 9.4b）：数据来自 model-catalog.json（D1），无 API 请求 */}
    {(data.benchmarks ?? []).length > 0 && (
      <section class="mt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('benchmark.resultsTitle')}
        </h2>
        <div class="mt-2 overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full min-w-[360px] text-left text-sm">
            <thead>
              <tr class="border-b border-slate-800 bg-slate-900/80 text-[11px] uppercase tracking-wide text-slate-500">
                <th scope="col" class="px-4 py-2.5 font-medium">{t('benchmark.pageTitle')}</th>
                <th scope="col" class="px-4 py-2.5 text-right font-medium">{t('benchmark.score')}</th>
                <th scope="col" class="px-4 py-2.5 font-medium">{t('benchmark.dataset')}</th>
                <th scope="col" class="px-4 py-2.5 font-medium">{t('benchmark.version')}</th>
              </tr>
            </thead>
            <tbody>
              {(data.benchmarks ?? []).map((bm) => (
                <tr class="border-b border-slate-800/60 last:border-b-0">
                  <td class="px-4 py-2.5 text-slate-200">{bm.categoryName}</td>
                  <td class="px-4 py-2.5 text-right font-semibold tabular-nums text-slate-100">
                    {bm.score}
                  </td>
                  <td class="px-4 py-2.5 text-slate-400">{bm.dataset}</td>
                  <td class="px-4 py-2.5 text-slate-400">{bm.version}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
    {/* FAQ（GEO：数据驱动问答区块，与 FAQPage JSON-LD 一致） */}
    <section class="mt-10 border-t border-slate-800 pt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('faq.title')}</h2>
      <div class="mt-4 space-y-3">
        {faqQuestions.map((q) => (
          <details class="group rounded-xl border border-slate-800 bg-slate-900/60 p-4">
            <summary class="cursor-pointer text-sm font-semibold text-white transition-colors group-hover:text-sky-300">
              {q.question}
            </summary>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{q.answer}</p>
          </details>
        ))}
      </div>
    </section>

    {/* Related Resources（Phase 10.5：内部链接增强，SSG 静态生成） */}
    <section class="mt-10 border-t border-slate-800 pt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('internalLinks.relatedResources')}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <a
          href={`/${lang}/ranking/`}
          class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 transition-colors hover:border-sky-500/60 hover:bg-slate-900"
        >
          <span class="text-sm font-semibold text-white">{t('internalLinks.leaderboard')}</span>
          <span class="mt-1 block text-xs text-slate-500">{t('internalLinks.relatedRanking')}</span>
        </a>
        <a
          href={`/${lang}/benchmarks/`}
          class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 transition-colors hover:border-sky-500/60 hover:bg-slate-900"
        >
          <span class="text-sm font-semibold text-white">{t('internalLinks.benchmarks')}</span>
          <span class="mt-1 block text-xs text-slate-500">{t('internalLinks.relatedBenchmarks')}</span>
        </a>
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 sm:col-span-2">
          <span class="text-sm font-semibold text-white">{t('internalLinks.compareTop')}</span>
          <div class="mt-2 flex flex-wrap gap-2">
            {compareVsTop.map((c) => (
              <a
                href={c.href}
                class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
              >
                {name} vs {c.name} →
              </a>
            ))}
          </div>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 sm:col-span-2">
          <span class="text-sm font-semibold text-white">{t('internalLinks.similarModels')}</span>
          <div class="mt-2 flex flex-wrap gap-2">
            {similar.map((s) => (
              <a
                href={`/${lang}/models/${s.slug}/`}
                class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
              >
                {s.name} →
              </a>
            ))}
          </div>
        </div>
        {relatedUseCases.length > 0 && (
          <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 sm:col-span-2">
            <span class="text-sm font-semibold text-white">{t('landing.useCases')}</span>
            <div class="mt-2 flex flex-wrap gap-2">
              {relatedUseCases.map((uc) => (
                <a
                  href={`/${lang}/use-cases/${uc.slug}/`}
                  class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-xs text-slate-300 transition-colors hover:border-sky-500/60 hover:text-white"
                >
                  {uc.title} →
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </article>
</BaseLayout>
