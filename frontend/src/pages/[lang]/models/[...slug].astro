---
/**
 * 模型详情页：/{lang}/models/[...slug]/
 *
 * SSG：构建期由 scripts/export-models.mjs 从本地 D1 导出数据（src/generated/），
 * 生成每个模型的静态详情页（SEO 最优）。数据与 Worker API 同源（D1）。
 *
 * 展示：名称 / Provider / Context Window / 输入输出价格 / 支持语言 / 描述 / 用途。
 */
import { LOCALES, LOCALE_LABELS, type Locale } from '../../../i18n/locales';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useI18n } from '../../../i18n/ui';
import { MODEL_SLUGS } from '../../../generated/model-slugs';
import catalogJson from '../../../generated/model-catalog.json';

// ---- 生成数据类型（与 scripts/export-models.mjs 输出一致）----
interface ModelCatalogEntry {
  slug: string;
  modelType: string;
  contextWindow: number | null;
  releaseDate: string | null;
  providerName: string;
  inputPrice: number | null;
  outputPrice: number | null;
  currency: string;
  unit: string;
  languages: string[];
  translations: Partial<
    Record<string, { name?: string; description?: string | null; useCases?: string[] | null }>
  >;
  benchmarks?: {
    category: string;
    categoryName: string;
    score: number;
    rank: number | null;
    dataset: string;
    version: string;
    testedAt: string | null;
  }[];
  ranking?: { overall: number; benchmark: number; capability: number; price: number; context: number };
  trend?: { rankChange: number | null; scoreChange: number | null } | null;
  rankingHistory?: { date: string; rank: number; score: number }[];
}
const catalog = catalogJson as Record<string, ModelCatalogEntry>;

// 组合 lang × slug 的全部静态路径
export function getStaticPaths() {
  const paths: { params: { lang: string; slug: string } }[] = [];
  for (const lang of LOCALES) {
    for (const slug of MODEL_SLUGS) {
      paths.push({ params: { lang, slug } });
    }
  }
  return paths;
}

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);
const slug = Astro.params.slug as string;
const data = catalog[slug];

// 数据缺失（构建时不应发生）→ 重定向 404
if (!data) {
  return Astro.redirect('/404');
}

const tr = data.translations[lang] ?? data.translations.en ?? {};
const name = tr.name ?? data.slug;
const description = tr.description ?? '';
const useCases = tr.useCases ?? [];
const languageNames = data.languages.map((code) => LOCALE_LABELS[code as Locale] ?? code);

// SVG 折线数据（Ranking History，Phase 9.6）
const history = data.rankingHistory ?? [];
const rankLine = (() => {
  const scores = history.map((h) => h.score);
  const min = Math.min(...scores);
  const max = Math.max(...scores);
  const range = max - min || 1;
  const W = 600;
  const H = 140;
  const PAD = 12;
  const xOf = (i: number) => (history.length <= 1 ? W / 2 : (i / (history.length - 1)) * (W - PAD * 2) + PAD);
  const yOf = (s: number) => H - PAD - ((s - min) / range) * (H - PAD * 2);
  const pointsAttr = history.map((h, i) => `${xOf(i).toFixed(1)},${yOf(h.score).toFixed(1)}`).join(' ');
  return { pointsAttr, min, max, yOf, first: history[0], last: history[history.length - 1] };
})();

const fmtNumber = (n: number | null): string =>
  n == null ? '—' : n.toLocaleString(lang === 'en' ? 'en-US' : lang);
const fmtPrice = (n: number | null): string => (n == null ? '—' : `$${n.toFixed(2)}`);

// 结构化数据（JSON-LD）：模型作为 Product，价格来自 D1
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description,
  brand: { '@type': 'Organization', name: data.providerName },
  offers: {
    '@type': 'Offer',
    price: data.inputPrice ?? undefined,
    priceCurrency: data.currency,
    description: 'Input price per 1M tokens',
  },
};

const detailRows: { label: string; value: string }[] = [
  { label: t('models.detailProvider'), value: data.providerName },
  { label: t('models.detailModelType'), value: data.modelType },
  { label: t('models.detailContextWindow'), value: fmtNumber(data.contextWindow) },
  {
    label: t('models.detailInputPrice'),
    value: `${fmtPrice(data.inputPrice)}${data.inputPrice != null ? t('models.unitLabel') : ''}`,
  },
  {
    label: t('models.detailOutputPrice'),
    value: `${fmtPrice(data.outputPrice)}${data.outputPrice != null ? t('models.unitLabel') : ''}`,
  },
  { label: t('models.detailReleaseDate'), value: data.releaseDate ?? '—' },
  { label: t('models.detailLanguages'), value: languageNames.join(', ') },
];
---

<BaseLayout title={`${name} | ${t('site.title')}`} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl">
    <a href={`/${lang}/models/`} class="text-sm text-sky-400 transition-colors hover:text-sky-300">
      ← {t('models.backToList')}
    </a>

    <header class="mt-4">
      <h1 class="text-3xl font-bold tracking-tight text-white">{name}</h1>
      <p class="mt-1 text-sm font-medium uppercase tracking-wide text-sky-400">
        {data.providerName}
      </p>
    </header>

    <dl class="mt-6 grid gap-px overflow-hidden rounded-xl border border-slate-800 bg-slate-800 sm:grid-cols-2">
      {detailRows.map((row) => (
        <div class="flex items-center justify-between gap-4 bg-slate-950 px-4 py-3">
          <dt class="text-sm text-slate-500">{row.label}</dt>
          <dd class="text-sm font-medium text-slate-100">{row.value}</dd>
        </div>
      ))}
    </dl>

    {description && (
      <section class="mt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('models.detailDescription')}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-300">{description}</p>
      </section>
    )}

    {useCases.length > 0 && (
      <section class="mt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('models.detailUseCases')}
        </h2>
        <ul class="mt-2 flex flex-wrap gap-2">
          {useCases.map((c) => (
            <li
              class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-xs text-slate-300"
            >
              {c}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Overall Ranking Card（Phase 9.5）：评分公式见 docs/ranking-design.md */}
    {data.ranking && (
      <section class="mt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('ranking.resultsTitle')}
        </h2>
        <div class="mt-2 grid gap-2 sm:grid-cols-5">
          <div class="rounded-xl border border-sky-500/40 bg-sky-500/10 p-4 text-center">
            <p class="text-[11px] uppercase tracking-wide text-sky-400">{t('ranking.overall')}</p>
            <p class="mt-1 text-2xl font-bold tabular-nums text-white">{data.ranking.overall}</p>
          </div>
          {[
            { label: t('ranking.benchmark'), value: data.ranking.benchmark },
            { label: t('ranking.capability'), value: data.ranking.capability },
            { label: t('ranking.efficiency'), value: data.ranking.price },
            { label: t('ranking.context'), value: data.ranking.context },
          ].map((item) => (
            <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 text-center">
              <p class="text-[11px] uppercase tracking-wide text-slate-500">{item.label}</p>
              <p class="mt-1 text-xl font-semibold tabular-nums text-slate-100">{item.value}</p>
            </div>
          ))}
        </div>
        <p class="mt-2 text-[11px] text-slate-600">{t('ranking.methodologyText')}</p>
      </section>
    )}

    {/* Ranking History 折线图（Phase 9.6）：轻量 SVG，最近 30 天 overall 分数 */}
    {(data.rankingHistory ?? []).length >= 2 && (
      <section class="mt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('snapshot.title')}
          <span class="ml-2 text-[10px] normal-case tracking-normal text-slate-600">
            {t('snapshot.last30')}
          </span>
        </h2>
        <div class="mt-2 overflow-x-auto rounded-xl border border-slate-800 bg-slate-950 p-3">
          <svg viewBox="0 0 600 160" role="img" class="h-auto w-full min-w-[420px]" aria-label={t('snapshot.title')}>
            <line x1="0" y1={rankLine.yOf(rankLine.max)} x2="600" y2={rankLine.yOf(rankLine.max)} class="stroke-slate-800" stroke-width="1" stroke-dasharray="4 4" />
            <line x1="0" y1={rankLine.yOf(rankLine.min)} x2="600" y2={rankLine.yOf(rankLine.min)} class="stroke-slate-800" stroke-width="1" stroke-dasharray="4 4" />
            <polyline points={rankLine.pointsAttr} fill="none" stroke="#38bdf8" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
            <text x="4" y={rankLine.yOf(rankLine.max) - 4} class="fill-slate-500" font-size="10">{rankLine.max}</text>
            <text x="4" y={rankLine.yOf(rankLine.min) + 12} class="fill-slate-500" font-size="10">{rankLine.min}</text>
            <text x="4" y="152" class="fill-slate-600" font-size="9">{rankLine.first.date}</text>
            <text x="596" y="152" text-anchor="end" class="fill-slate-600" font-size="9">{rankLine.last.date}</text>
          </svg>
        </div>
      </section>
    )}

    {/* Benchmark Results（Phase 9.4b）：数据来自 model-catalog.json（D1），无 API 请求 */}
    {(data.benchmarks ?? []).length > 0 && (
      <section class="mt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
          {t('benchmark.resultsTitle')}
        </h2>
        <div class="mt-2 overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full min-w-[360px] text-left text-sm">
            <thead>
              <tr class="border-b border-slate-800 bg-slate-900/80 text-[11px] uppercase tracking-wide text-slate-500">
                <th scope="col" class="px-4 py-2.5 font-medium">{t('benchmark.pageTitle')}</th>
                <th scope="col" class="px-4 py-2.5 text-right font-medium">{t('benchmark.score')}</th>
                <th scope="col" class="px-4 py-2.5 font-medium">{t('benchmark.dataset')}</th>
                <th scope="col" class="px-4 py-2.5 font-medium">{t('benchmark.version')}</th>
              </tr>
            </thead>
            <tbody>
              {(data.benchmarks ?? []).map((bm) => (
                <tr class="border-b border-slate-800/60 last:border-b-0">
                  <td class="px-4 py-2.5 text-slate-200">{bm.categoryName}</td>
                  <td class="px-4 py-2.5 text-right font-semibold tabular-nums text-slate-100">
                    {bm.score}
                  </td>
                  <td class="px-4 py-2.5 text-slate-400">{bm.dataset}</td>
                  <td class="px-4 py-2.5 text-slate-400">{bm.version}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
