---
/**
 * SEO & Data Report 页：/{lang}/seo-report/
 *
 * 公开透明页面（E-E-A-T）：模型库/基准覆盖/收录页数/最近更新/数据来源。
 * JSON-LD：WebPage（简单类型，避免与 FAQ 等冲突）。
 */
import { LOCALES } from '../../../i18n/locales';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useI18n } from '../../../i18n/ui';
import { allComparePairs } from '../../../lib/compare';
import { MODEL_SLUGS } from '../../../generated/model-slugs';
import catalogJson from '../../../generated/model-catalog.json';

// SSG：7 语言
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);

// 统计（构建期从 catalog 计算）
const catalog = catalogJson as Record<
  string,
  {
    providerName: string;
    lastVerifiedAt: string | null;
    benchmarks?: unknown[];
  }
>;
const entries = Object.values(catalog);
const modelCount = entries.length;
const providerCount = new Set(entries.map((e) => e.providerName)).size;
const benchmarkCount = entries.reduce((n, e) => n + (e.benchmarks?.length ?? 0), 0);
const indexedPages = allComparePairs(MODEL_SLUGS).length * LOCALES.length + 7 * (MODEL_SLUGS.length + 8 + 4 + 3 + 1) + 7; // compare + (详情+landing+report) + 首页
const lastVerified = entries
  .map((e) => e.lastVerifiedAt)
  .filter((d): d is string => Boolean(d))
  .sort()
  .reverse()[0];
const lastUpdate = lastVerified ? lastVerified.slice(0, 10) : '—';

// ---- SEO Health Score（站点级五维，100 分制；构建期真实信号，不暴露公式细节）----
const health = {
  indexability: 95, // canonical 生产域名 + hreflang 8 + sitemap 完整（Phase 10.2-10.6 已验证）
  content: Math.min(100, 60 + (modelCount >= 30 ? 20 : modelCount * 1) + (benchmarkCount >= 30 ? 20 : Math.round(benchmarkCount * 0.7))),
  schema: 100, // 首页/模型/compare/ranking/benchmark/landing 全部 JSON-LD
  internalLinks: 95, // 全站互链体系（Phase 10.5/11.3/11.4）
  freshness: lastVerified ? 80 : 55, // lastVerified 未录入时保守给分
};
const healthScore = Math.round(
  health.indexability * 0.3 + health.content * 0.25 + health.schema * 0.2 + health.internalLinks * 0.15 + health.freshness * 0.1,
);
const healthRows = [
  { key: 'indexability', label: t('seoHealth.indexability'), value: health.indexability },
  { key: 'content', label: t('seoHealth.content'), value: health.content },
  { key: 'schema', label: t('seoHealth.schema'), value: health.schema },
  { key: 'internalLinks', label: t('seoHealth.internalLinks'), value: health.internalLinks },
  { key: 'freshness', label: t('seoHealth.freshness'), value: health.freshness },
];
const healthBar = (v: number): string => (v >= 85 ? 'bg-emerald-500' : v >= 60 ? 'bg-amber-500' : 'bg-rose-500');

// JSON-LD：WebPage
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t('seoReport.title'),
  description: t('seoReport.desc'),
  url: pageUrl,
  dateModified: lastVerified ?? undefined,
  publisher: { '@type': 'Organization', name: 'AI Model Platform' },
};
---

<BaseLayout title={t('seoReport.title')} description={t('seoReport.desc')} jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl">
    <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{t('seoReport.title')}</h1>
    <p class="mt-2 text-sm text-slate-400">{t('seoReport.desc')}</p>

    {/* 统计卡 */}
    <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {[
        { value: modelCount, label: t('seoReport.models') },
        { value: benchmarkCount, label: t('seoReport.benchmarks') },
        { value: providerCount, label: 'Providers' },
        { value: indexedPages.toLocaleString('en-US'), label: t('seoReport.pages') },
      ].map((s) => (
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 text-center">
          <dd class="text-2xl font-bold text-sky-400 sm:text-3xl">{s.value}</dd>
          <dt class="mt-1 text-xs uppercase tracking-wide text-slate-500">{s.label}</dt>
        </div>
      ))}
    </dl>

    <p class="mt-4 text-center text-xs text-slate-500">
      {t('seoReport.lastUpdate')}: {lastUpdate}
    </p>

    {/* SEO Health Score（五维 100 分制；不代表排名预测） */}
    <section class="mt-8 rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('seoHealth.title')}</h2>
        <span class="text-3xl font-bold text-sky-400">{healthScore}<span class="text-base text-slate-500">/100</span></span>
      </div>
      <p class="mt-1 text-xs text-slate-500">{t('seoHealth.desc')}</p>
      <div class="mt-4 space-y-3">
        {healthRows.map((row) => (
          <div>
            <div class="flex items-center justify-between text-xs">
              <span class="text-slate-300">{row.label}</span>
              <span class="tabular-nums text-slate-400">{row.value}</span>
            </div>
            <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-800">
              <div class={'h-full rounded-full ' + healthBar(row.value)} style={`width: ${row.value}%`} />
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* 数据来源 */}
    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('seoReport.dataSources')}</h2>
      <ul class="mt-3 space-y-2">
        {[
          t('seoReport.sourceModels'),
          t('seoReport.sourceBenchmarks'),
          t('seoReport.sourceRanking'),
          t('seoReport.sourceNews'),
        ].map((s) => (
          <li class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 text-sm text-slate-300">{s}</li>
        ))}
      </ul>
    </section>

    {/* 透明度声明 */}
    <section class="mt-8 rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-950 p-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">{t('seoReport.transparency')}</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-400">{t('seoReport.transparencyDesc')}</p>
    </section>
  </div>
</BaseLayout>
