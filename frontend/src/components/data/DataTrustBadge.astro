---
/**
 * DataTrustBadge —— 数据可信徽章（Phase 11.5A）
 *
 * 基于 confidence（0-100）或 verification status 显示颜色与文案（i18n，7 语言）：
 *   confidence >= 90 或 status=verified → Verified（绿）
 *   confidence 70-89 或 status=trusted  → Trusted（蓝）
 *   其他（<70 / experimental / unverified）→ Experimental（琥珀）
 *
 * 颜色只根据 confidence；label 可覆盖（如来源名）。
 */
import { getLangFromUrl, useI18n } from '../../i18n/ui';

interface Props {
  /** 0-100；缺省时按 status 推断 */
  confidence?: number | null;
  /** verified / trusted / experimental / unverified / official / community / manual */
  status?: string | null;
  /** 附加文案（如来源名） */
  label?: string;
}

const { confidence, status, label } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);

const level =
  confidence != null
    ? confidence >= 90
      ? 'verified'
      : confidence >= 70
        ? 'trusted'
        : 'experimental'
    : status === 'verified' || status === 'official'
      ? 'verified'
      : status === 'trusted' || status === 'community' || status === 'benchmark'
        ? 'trusted'
        : 'experimental';

const text: Record<string, string> = {
  verified: t('confidence.verified'),
  trusted: t('confidence.trusted'),
  experimental: t('confidence.experimental'),
};
const style: Record<string, string> = {
  verified: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30',
  trusted: 'bg-sky-500/15 text-sky-300 border-sky-500/30',
  experimental: 'bg-amber-500/15 text-amber-400 border-amber-500/30',
};
---

<span
  class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${style[level]}`}
>
  <span
    class={`h-1.5 w-1.5 rounded-full ${level === 'verified' ? 'bg-emerald-400' : level === 'trusted' ? 'bg-sky-400' : 'bg-amber-400'}`}
  />
  {label ?? text[level]}
</span>
