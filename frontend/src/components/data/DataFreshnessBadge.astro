---
/**
 * DataFreshnessBadge —— 数据新鲜度徽章（Phase 11.6）
 *
 * 基于 lastVerifiedAt 距今天数（真实数据）：
 *   ≤1 天    → "Updated today"（绿）
 *   ≤30 天   → "Updated N days ago"（蓝）
 *   ≤180 天  → "Updated N month(s) ago"（琥珀）
 *   >180 天 / 无数据 → "Needs verification"（红）
 * 7 语言 i18n。
 */
import { getLangFromUrl, useI18n } from '../../i18n/ui';

interface Props {
  lastVerifiedAt: string | null;
}

const { lastVerifiedAt } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useI18n(lang);

const days = lastVerifiedAt ? Math.floor((Date.now() - new Date(lastVerifiedAt).getTime()) / 86_400_000) : null;

let label: string;
let cls: string;
if (days == null || days > 180) {
  label = t('trust.needsVerification');
  cls = 'bg-rose-500/15 text-rose-400 border-rose-500/30';
} else if (days <= 1) {
  label = t('trust.freshToday');
  cls = 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30';
} else if (days <= 30) {
  label = t('trust.freshDays', { n: String(days) });
  cls = 'bg-sky-500/15 text-sky-300 border-sky-500/30';
} else {
  label = t('trust.freshMonth', { n: String(Math.round(days / 30)) });
  cls = 'bg-amber-500/15 text-amber-400 border-amber-500/30';
}
---

<span class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${cls}`}>
  <span class={`h-1.5 w-1.5 rounded-full ${days == null || days > 180 ? 'bg-rose-400' : days <= 1 ? 'bg-emerald-400' : days <= 30 ? 'bg-sky-400' : 'bg-amber-400'}`} />
  {label}
</span>
