---
/**
 * 语言切换器（升级版）：
 * - 链接形式（对 SEO/无 JS 环境友好），基于当前页面路径翻译目标语言 URL；
 * - 当前语言高亮 + aria-current；
 * - 无障碍：aria-label 来自字典，sr-only 提示当前语言；
 * - 点击时记录手动语言偏好到 localStorage，自动语言识别将尊重该选择。
 */
import { LOCALE_LABELS, type Locale } from '../i18n/locales';
import { translateUrl, useI18n } from '../i18n/ui';
import { LANG_STORAGE_KEY } from '../i18n/auto-locale';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useI18n(lang);
---

<nav aria-label={t('lang.switcherLabel')} class="shrink-0">
  <ul class="flex flex-wrap items-center justify-end gap-1 rounded-full border border-slate-700 bg-slate-800/60 px-1.5 py-1">
    {
      LOCALE_LABELS && Object.entries(LOCALE_LABELS).map(([code, label]) => {
        const targetLang = code as Locale;
        const isCurrent = targetLang === lang;
        return (
          <li>
            <a
              href={translateUrl(Astro.url, targetLang)}
              aria-current={isCurrent ? 'true' : undefined}
              onclick={`localStorage.setItem('${LANG_STORAGE_KEY}', '${targetLang}')`}
              title={label}
              class:list={[
                'rounded-full px-2.5 py-1 text-xs font-medium transition-colors',
                isCurrent
                  ? 'bg-sky-500 text-white'
                  : 'text-slate-300 hover:bg-slate-700 hover:text-white',
              ]}
            >
              {label}
            </a>
          </li>
        );
      })
    }
  </ul>
  <span class="sr-only">{t('lang.current', { lang: LOCALE_LABELS[lang] })}</span>
</nav>
