---
/**
 * 语言切换器（下拉模式）：
 * - 原生 <select> 固定宽度单行，不改变页面顶部布局（7 语言缩写选项）；
 * - 每个选项值为完整目标 URL（服务器生成，非 JS 拼接），SEO/hreflang 不受影响
 *   （hreflang/canonical 由 head 中 SEO 组件生成，与 UI 形式无关）；
 * - 切换时记录语言偏好到 localStorage，自动语言识别将尊重该选择；
 * - 无 JS 场景：select 不可交互但页面其余功能正常（可选 onchange 跳转）。
 */
import { LOCALE_LABELS, type Locale } from '../i18n/locales';
import { translateUrl, useI18n } from '../i18n/ui';
import { LANG_STORAGE_KEY } from '../i18n/auto-locale';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useI18n(lang);
const options = Object.entries(LOCALE_LABELS).map(([code, label]) => {
  const targetLang = code as Locale;
  return {
    code: targetLang,
    label,
    href: translateUrl(Astro.url, targetLang),
    isCurrent: targetLang === lang,
  };
});
---

<div class="relative shrink-0">
  <select
    aria-label={t('lang.switcherLabel')}
    title={t('lang.switcherLabel')}
    class="cursor-pointer appearance-none rounded-full border border-slate-700 bg-slate-800/60 py-1 pl-3 pr-8 text-xs font-medium text-slate-200 outline-none transition-colors hover:border-slate-500 focus:border-sky-500"
    onchange={`const v = this.value; if (v) { localStorage.setItem('${LANG_STORAGE_KEY}', this.options[this.selectedIndex].dataset.lang || ''); window.location.href = v; }`}
  >
    {
      options.map((o) => (
        <option value={o.href} data-lang={o.code} selected={o.isCurrent}>
          {o.label}
        </option>
      ))
    }
  </select>
  {/* 自定义箭头（替代 appearance-none 的原生箭头） */}
  <svg
    class="pointer-events-none absolute right-2.5 top-1/2 h-3 w-3 -translate-y-1/2 text-slate-400"
    viewBox="0 0 12 12"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</div>
